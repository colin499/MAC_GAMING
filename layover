def parse_vdf(text):
    """Minimal Valve KeyValues parser (enough for appmanifest/loginusers/libraryfolders)."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    stack = [{}]
    key = None
    for s, b in tokens:
        if b == "{":
            new = {}
            stack[-1][key] = new
            stack.append(new)
            key = None
        elif b == "}":
            stack.pop()
        else:
            if key is None:
                key = s
            else:
                stack[-1][key] = s
                key = None
    return stack[0]


def steam_libraries(steamapps):
    libs = [steamapps] if os.path.isdir(steamapps) else []
    lf = os.path.join(steamapps, "libraryfolders.vdf")
    if os.path.exists(lf):
        try:
            with open(lf, errors="replace") as f:
                data = parse_vdf(f.read()).get("libraryfolders", {})
            for v in data.values():
                if isinstance(v, dict) and v.get("path"):
                    p = v["path"]
                    if p.startswith("C:\\") or p.startswith("c:\\"):
                        p = os.path.join(PREFIX, "drive_c", p[3:].replace("\\", "/"))
                    p = os.path.join(p, "steamapps")
                    if os.path.isdir(p) and os.path.realpath(p) not in map(os.path.realpath, libs):
                        libs.append(p)
        except OSError:
            pass
    return libs


def installed_games(steamapps):
    games = []
    for lib in steam_libraries(steamapps):
        if not os.path.isdir(lib):
            continue
        for fn in sorted(os.listdir(lib)):
            if fn.startswith("appmanifest_") and fn.endswith(".acf"):
                try:
                    with open(os.path.join(lib, fn), errors="replace") as f:
                        st = parse_vdf(f.read()).get("AppState", {})
                except OSError:
                    continue
                flags = int(st.get("StateFlags", "0") or 0)
                games.append({
                    "appid": st.get("appid", fn[12:-4]),
                    "name": st.get("name", "?"),
                    "size": int(st.get("SizeOnDisk", "0") or 0),
                    "ready": flags == 4,
                    "flags": flags,
                    "needs_update": bool(flags & (2 | 256 | 1024)) or flags not in (4,),
                    "library": lib,
                    "installdir": st.get("installdir", ""),
                    "bytes_to_download": _int(st.get("BytesToDownload")), "bytes_downloaded": _int(st.get("BytesDownloaded")),
                    "bytes_to_stage": _int(st.get("BytesToStage")), "bytes_staged": _int(st.get("BytesStaged")),
                    "last_updated": _int(st.get("LastUpdated")), "last_played": _int(st.get("LastPlayed")),
                    "buildid": st.get("buildid", ""), "target_buildid": st.get("TargetBuildID", ""),
                })
    return games


def _int(v, default=0):
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return default


def all_games():
    out = []
    if steam_installed():
        for g in installed_games(os.path.join(STEAM_DIR, "steamapps")):
            g["where"] = "windows"
            out.append(g)
    if os.path.isdir(os.path.join(NATIVE_STEAM_DIR, "steamapps")):
        for g in installed_games(os.path.join(NATIVE_STEAM_DIR, "steamapps")):
            g["where"] = "mac"
            out.append(g)
    return out


def find_game(query, games):
    q = query.strip().lower()
    exact = [g for g in games if g["appid"] == q or g["name"].lower() == q]
    if exact:
        return exact[0]
    subs = [g for g in games if q in g["name"].lower()]
    if len(subs) == 1:
        return subs[0]
    if not subs or JSON_MODE:
        return None
    print("  Which one?")
    for i, g in enumerate(subs, 1):
        print(f"    {i}. {g['name']}  ({g['where']}, {g['appid']})")
    try:
        pick = int(input("  > ")) - 1
        return subs[pick]
    except (ValueError, IndexError, EOFError):
        return None


def loginusers_path(where):
    base = STEAM_DIR if where == "windows" else NATIVE_STEAM_DIR
    return os.path.join(base, "config", "loginusers.vdf")


def steam_accounts(where):
    p = loginusers_path(where)
    if not os.path.exists(p):
        return {}
    with open(p, errors="replace") as f:
        return parse_vdf(f.read()).get("users", {})


def steam_connection_state():
    """Last state in Steam's connection_log.txt ("Logged On", "Disconnected", "Connecting", ...); None if unknown."""
    try:
        with open(os.path.join(STEAM_DIR, "logs", "connection_log.txt"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode(errors="replace")
    except OSError:
        return None
    states = re.findall(r"^\[[^\]]+\] \[([A-Za-z ]+?),", tail, re.M)
    return states[-1] if states else None


def wants_offline(where="windows"):
    p = loginusers_path(where)
    try:
        with open(p, errors="replace") as f:
            return re.search(r'"WantsOfflineMode"\s+"1"', f.read()) is not None
    except OSError:
        return False


def wait_for_steam_logon(timeout=45):
    """After the Mac sleeps, Steam takes a while to reconnect. Launching a game before it is logged on makes
    Steam's controller-config / cloud sync fail and it then waits on a dialog ("Launching...") that nobody
    sees behind the game. Wait a little for "Logged On" (skipped in offline mode)."""
    if wants_offline() or steam_connection_state() in (None, "Logged On"):
        return True
    info("Steam is not connected yet (" + str(steam_connection_state()) + "); waiting for it to log on")
    for _ in range(timeout // 2):
        time.sleep(2)
        if steam_connection_state() == "Logged On":
            return True
    warn("Steam still is not logged on; launching anyway (if Steam shows a 'Launching...' dialog, answer it)")
    return False


def steam_launch_prompt(appid):
    """True if Steam's console log shows a launch of this app stuck waiting for the user (a dialog)."""
    try:
        with open(os.path.join(STEAM_DIR, "logs", "console_log.txt"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode(errors="replace")
    except OSError:
        return False
    last = [l for l in tail.splitlines() if f"GameAction [AppID {appid}," in l]
    return bool(last) and "waiting for user response" in last[-1]


def set_offline_mode(where, offline):
    """Flip Steam's remembered 'WantsOfflineMode' so it boots straight into offline mode."""
    p = loginusers_path(where)
    if not os.path.exists(p):
        return False
    with open(p, errors="replace") as f:
        text = f.read()
    if '"WantsOfflineMode"' not in text:
        return False
    val = "1" if offline else "0"
    text = re.sub(r'("WantsOfflineMode"\s+")\d(")', rf'\g<1>{val}\2', text)
    text = re.sub(r'("SkipOfflineModeWarning"\s+")\d(")', rf'\g<1>{val}\2', text)
    with open(p, "w") as f:
        f.write(text)
    return True



# --------------------------------------------------------------------------- steam appcache (binary KeyValues)
# Steam keeps what it knows about apps and licenses in binary KeyValues files under appcache/, and that is
# what its own library view is built from. No network, no API key:
#   appinfo.vdf                   one record per app the client has seen (owned, installed, store pages): name,
#                                 type, oslist, launch entries, installdir, Steam Deck rating. v27/v28/v29 headers.
#   packageinfo.vdf               one record per license package the account holds. Package 0 is Steam's
#                                 complimentary set (TF2, Dota 2, demos, tools); every other package is a purchase.
#   librarycache/assetcache.vdf   appid -> the cover/hero/header/logo files cached for the library UI (newer Steam
#                                 puts them in sha-named subfolders of librarycache/<appid>/).
BINKV_END = (0x08, 0x0B)
ASSET_SLOTS = {"0f": "capsule", "1f": "hero", "2f": "logo", "3f": "header", "4f": "icon", "5f": "hero_blur"}
COVER_KINDS = ("capsule", "header", "hero", "logo", "icon", "hero_blur")
COVER_FILES = {"capsule": ("library_600x900.jpg", "library_600x900_2x.jpg", "library_capsule.jpg"),
               "header": ("header.jpg", "library_header.jpg"), "hero": ("library_hero.jpg",),
               "logo": ("logo.png", "logo.jpg"), "icon": (), "hero_blur": ("library_hero_blur.jpg",)}
COVER_CDN = ("https://cdn.cloudflare.steamstatic.com/steam/apps/{appid}/{file}",
             "https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/{appid}/{file}")
COVER_CDN_FILE = {"capsule": "library_600x900.jpg", "header": "header.jpg", "hero": "library_hero.jpg", "logo": "logo.png"}
NON_GAME_TYPES = ("tool", "dlc", "config", "music", "video", "series", "depot", "hardware", "beta", "advertising", "guide", "mod", "plugin")
STEAMID64_BASE = 76561197960265728
UA = f"{APP_NAME}/{VERSION} (macOS)"
# Valve's EAppState bits (appmanifest StateFlags)
APP_STATE_BITS = {1: "uninstalled", 2: "update_required", 4: "fully_installed", 8: "encrypted", 16: "locked",
                  32: "files_missing", 64: "app_running", 128: "files_corrupt", 256: "update_running", 512: "update_paused",
                  1024: "update_started", 2048: "uninstalling", 4096: "backup_running", 65536: "reconfiguring",
                  131072: "validating", 262144: "adding_files", 524288: "preallocating", 1048576: "downloading",
                  2097152: "staging", 4194304: "committing", 8388608: "update_stopping"}
DOWNLOADING_BITS = 256 | 1024 | 131072 | 262144 | 524288 | 1048576 | 2097152 | 4194304


def binkv_read(data, pos, strings=None):
    """Parse one binary KeyValues dict starting at pos. Returns (dict, position after the end marker).
    Keys are NUL-terminated strings, or (appinfo v29) u32 indices into a string table."""
    out = {}
    n = len(data)
    while pos < n:
        t = data[pos]
        pos += 1
        if t in BINKV_END:
            return out, pos
        if strings is not None:
            idx, = struct.unpack_from("<I", data, pos)
            pos += 4
            key = strings[idx] if idx < len(strings) else str(idx)
        else:
            e = data.index(b"\0", pos)
            key = data[pos:e].decode("utf-8", "replace")
            pos = e + 1
        if t == 0x00:
            val, pos = binkv_read(data, pos, strings)
        elif t == 0x01:
            e = data.index(b"\0", pos)
            val = data[pos:e].decode("utf-8", "replace")
            pos = e + 1
        elif t == 0x02:
            val, = struct.unpack_from("<i", data, pos); pos += 4
        elif t == 0x03:
            val, = struct.unpack_from("<f", data, pos); pos += 4
        elif t in (0x04, 0x06):
            val, = struct.unpack_from("<I", data, pos); pos += 4
        elif t == 0x05:
            e = pos
            while data[e:e + 2] != b"\0\0":
                e += 2
            val = data[pos:e].decode("utf-16-le", "replace")
            pos = e + 2
        elif t == 0x07:
            val, = struct.unpack_from("<Q", data, pos); pos += 8
        elif t == 0x0A:
            val, = struct.unpack_from("<q", data, pos); pos += 8
        else:
            raise ValueError(f"binary KeyValues: unknown node type {t:#x} at offset {pos - 1}")
        out[key] = val
    raise ValueError("binary KeyValues: unterminated dict")


def parse_appinfo(path=APPINFO_VDF):
    """{appid: appinfo dict} from Steam's appinfo.vdf (versions 0x27, 0x28, 0x29). ValueError on an unknown format.
    Record: appid u32 (0 ends the file), size u32, 40-byte header (+20-byte hash from v28), binary KeyValues."""
    with open(path, "rb") as f:
        data = f.read()
    if len(data) < 16:
        raise ValueError("appinfo.vdf: too short")
    magic, _universe = struct.unpack_from("<II", data, 0)
    ver = magic & 0xFF
    if magic >> 8 != 0x075644 or ver not in (0x27, 0x28, 0x29):
        raise ValueError(f"appinfo.vdf: unsupported format {magic:#x}")
    strings = None
    pos = 8
    if ver >= 0x29:
        st_off, = struct.unpack_from("<q", data, 8)
        pos = 16
        count, = struct.unpack_from("<I", data, st_off)
        strings = []
        p = st_off + 4
        for _ in range(count):
            e = data.index(b"\0", p)
            strings.append(data[p:e].decode("utf-8", "replace"))
            p = e + 1
    header = 40 + (20 if ver >= 0x28 else 0)
    apps = {}
    while pos + 8 <= len(data):
        appid, size = struct.unpack_from("<II", data, pos)
        if appid == 0:
            break
        start = pos + 8
        try:
            kv, _ = binkv_read(data, start + header, strings)
            apps[str(appid)] = kv.get("appinfo", kv)
        except (ValueError, IndexError, struct.error):
            pass   # one odd record must not hide the rest
        pos = start + size
    if not apps:
        raise ValueError("appinfo.vdf: no readable records")
    return apps


def parse_packageinfo(path=PACKAGEINFO_VDF):
    """{package id: {appids, depotids, billingtype, licensetype, status}} from packageinfo.vdf (the licenses)."""
    with open(path, "rb") as f:
        data = f.read()
    magic, _universe = struct.unpack_from("<II", data, 0)
    if magic not in (0x06565527, 0x06565528):
        raise ValueError(f"packageinfo.vdf: unsupported format {magic:#x}")
    pos = 8
    pkgs = {}
    while pos + 4 <= len(data):
        pkgid, = struct.unpack_from("<I", data, pos)
        if pkgid == 0xFFFFFFFF:
            break
        pos += 4 + 20 + 4 + (8 if magic == 0x06565528 else 0)   # sha1, change number, (token)
        kv, pos = binkv_read(data, pos)
        body = kv.get(str(pkgid))
        if body is None:
            body = next(iter(kv.values()), {}) if kv else {}
        if not isinstance(body, dict):
            body = {}
        ints = lambda d: sorted({int(v) for v in (d or {}).values() if str(v).isdigit()})
        pkgs[str(pkgid)] = {"appids": ints(body.get("appids")), "depotids": ints(body.get("depotids")),
                            "billingtype": body.get("billingtype"), "licensetype": body.get("licensetype"), "status": body.get("status")}
    return pkgs


def parse_assetcache(path=ASSETCACHE_VDF):
    """{appid: {capsule|hero|logo|header|icon|hero_blur: path relative to librarycache/<appid>/}}; {} if absent."""
    try:
        with open(path, "rb") as f:
            data = f.read()
        kv, _ = binkv_read(data, 0)
    except (OSError, ValueError, IndexError, struct.error):
        return {}
    root = kv.get("", kv)
    apps = root.get("0", {}) if isinstance(root, dict) else {}
    out = {}
    for appid, slots in apps.items():
        if isinstance(slots, dict):
            out[str(appid)] = {ASSET_SLOTS[k]: v for k, v in slots.items() if k in ASSET_SLOTS and isinstance(v, str)}
    return out


def _kv(d, *path, default=None):
    """Nested lookup with case-insensitive keys (Steam writes 'Steam'/'steam', 'ReleaseState'/'releasestate')."""
    for k in path:
        if not isinstance(d, dict):
            return default
        if k in d:
            d = d[k]
        else:
            low = {str(x).lower(): x for x in d}
            if str(k).lower() not in low:
                return default
            d = d[low[str(k).lower()]]
    return d


def appinfo_summary(info):
    """The part of one appinfo record Layover shows and decides on."""
    common = info.get("common") or {}
    config = info.get("config") or {}
    ext = info.get("extended") or {}
    launch = []
    entries = config.get("launch") or {}
    for k in sorted(entries, key=lambda x: int(x) if str(x).isdigit() else 0):
        e = entries[k]
        if not isinstance(e, dict):
            continue
        osl = str(_kv(e, "config", "oslist", default="") or "")
        if osl and "windows" not in osl:
            continue
        betas = str(_kv(e, "config", "betakey", default="") or "")   # which branches show the entry; "default" = everyone
        if betas and "default" not in [b.strip() for b in betas.split(",")]:
            continue
        desc = e.get("description") or _kv(e, "description_loc", "english", default="") or ""
        launch.append({"exe": str(e.get("executable", "")).replace("\\", "/"), "args": str(e.get("arguments", "")),
                       "description": str(desc), "type": str(e.get("type", "")),
                       "needs_dlc": str(_kv(e, "config", "ownsdlc", default="") or "")})
    assoc = common.get("associations") or {}
    names = lambda kind: [str(a.get("name")) for a in assoc.values() if isinstance(a, dict) and a.get("type") == kind and a.get("name")]
    deck = _kv(common, "steam_deck_compatibility", "category")
    try:
        deck = int(deck) if deck is not None and str(deck).strip() != "" else None
    except (TypeError, ValueError):
        deck = None
    return {
        "name": str(common.get("name", "")),
        "type": str(common.get("type", "")).lower(),
        "oslist": str(common.get("oslist", "")),
        "osarch": str(common.get("osarch", "")),
        "release_state": str(_kv(common, "ReleaseState", default="") or ""),
        "controller_support": str(common.get("controller_support", "")),
        "deck_category": deck,
        "developer": str(ext.get("developer") or (names("developer") or [""])[0]),
        "publisher": str(ext.get("publisher") or (names("publisher") or [""])[0]),
        "installdir": str(config.get("installdir", "")),
        "launch": launch,
        "dlc": [x.strip() for x in str(ext.get("listofdlc", "")).split(",") if x.strip().isdigit()],
        "parent": str(common.get("parent")) if common.get("parent") else None,
        "library_assets": bool(common.get("library_assets_full") or common.get("library_assets")),
    }


def _file_key(path):
    try:
        st = os.stat(path)
        return [st.st_mtime_ns, st.st_size]
    except OSError:
        return None


def _json_cache(name, source, version, build):
    """build(source) once per (mtime, size) of the source file, remembered in cache/<name>.json.
    Returns (data, error); error is set when the file could not be parsed (Steam changed the format)."""
    key = _file_key(source)
    if key is None:
        return None, f"{os.path.basename(source)} missing"
    cpath = os.path.join(CACHE_DIR, name + ".json")
    try:
        with open(cpath) as f:
            c = json.load(f)
        if c.get("key") == key and c.get("version") == version:
            return c.get("data"), c.get("error")
    except (OSError, ValueError):
        pass
    data, err = None, None
    try:
        data = build(source)
    except (ValueError, IndexError, struct.error, OSError) as e:
        err = f"{os.path.basename(source)}: {e}"
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(cpath + ".tmp", "w") as f:
            json.dump({"key": key, "version": version, "data": data, "error": err}, f)
        os.replace(cpath + ".tmp", cpath)
    except OSError:
        pass
    return data, err


def cached_appinfo():
    return _json_cache("appinfo", APPINFO_VDF, 1, lambda p: {a: appinfo_summary(i) for a, i in parse_appinfo(p).items()})


def cached_packageinfo():
    return _json_cache("packageinfo", PACKAGEINFO_VDF, 1, parse_packageinfo)


