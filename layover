def wrapper_binary():
    """Path to the compiled wrapper. A copy is kept under Application Support because macOS
    may refuse Terminal access to files in Documents (Files & Folders privacy); builds it with
    mingw-w64 if no prebuilt copy exists."""
    os.makedirs(TOOLS, exist_ok=True)
    try:
        if os.path.exists(WRAPPER_EXE) and 0 < os.path.getsize(WRAPPER_EXE) < WRAPPER_MAX_SIZE:
            if not os.path.exists(WRAPPER_INSTALLED) or os.path.getsize(WRAPPER_INSTALLED) != os.path.getsize(WRAPPER_EXE):
                shutil.copy2(WRAPPER_EXE, WRAPPER_INSTALLED)
    except PermissionError:
        if not os.path.exists(WRAPPER_INSTALLED):
            warn("macOS blocked reading the wrapper from the Documents folder.")
            warn("Allow Terminal in System Settings → Privacy & Security → Files and Folders → Documents, or run `layover setup` once from the original session.")
    if os.path.exists(WRAPPER_INSTALLED):
        return WRAPPER_INSTALLED
    src = os.path.join(WRAPPER_SRC_DIR, "src", "steamwebhelper-wrapper.c")
    if not os.path.exists(src):
        return None
    if not os.path.exists(MINGW_GCC):
        info("installing the mingw-w64 cross compiler to build the Steam web-helper wrapper (one time, ~1.5 GB)")
        subprocess.run(["brew", "install", "mingw-w64"])
    if not os.path.exists(MINGW_GCC):
        return None
    r = run([MINGW_GCC, "-O2", "-municode", "-DUNICODE", "-D_UNICODE", "-o", WRAPPER_INSTALLED, src,
             "-static", "-lshell32", "-mwindows"])
    if r.returncode != 0:
        warn("wrapper build failed: " + r.stderr[-400:])
        return None
    return WRAPPER_INSTALLED


def install_webhelper_wrapper(quiet=True):
    """Make sure every cef.win* dir has: steamwebhelper.exe = our wrapper, steamwebhelper_real.exe = Valve's.
    Safe to call before every launch; it heals whatever state Steam's updater left behind."""
    cef_root = os.path.join(STEAM_DIR, "bin", "cef")
    if not os.path.isdir(cef_root):
        return False
    wrapper = wrapper_binary()
    if not wrapper:
        warn("no web-helper wrapper available; Steam's window may be black")
        return False
    done = False
    for d in os.listdir(cef_root):
        cef = os.path.join(cef_root, d)
        target = os.path.join(cef, "steamwebhelper.exe")
        real = os.path.join(cef, "steamwebhelper_real.exe")
        if not os.path.isfile(target):
            continue
        target_is_valve = os.path.getsize(target) > WRAPPER_MAX_SIZE
        real_is_valve = os.path.isfile(real) and os.path.getsize(real) > WRAPPER_MAX_SIZE
        if target_is_valve:
            # Steam restored/updated its helper: keep the newest Valve copy as _real.
            shutil.move(target, real)
            real_is_valve = True
        if not real_is_valve:
            warn(f"{d}: Valve's steamwebhelper is missing; run `layover update-steam` to restore it")
            continue
        if not os.path.isfile(target) or not _same_file(wrapper, target) or os.path.getsize(target) != os.path.getsize(wrapper):
            shutil.copy2(wrapper, target)
        done = True
    if done and not quiet:
        ok("Steam web-helper wrapper in place")
    return done


def remove_webhelper_wrapper():
    cef_root = os.path.join(STEAM_DIR, "bin", "cef")
    if not os.path.isdir(cef_root):
        return
    for d in os.listdir(cef_root):
        cef = os.path.join(cef_root, d)
        target = os.path.join(cef, "steamwebhelper.exe")
        real = os.path.join(cef, "steamwebhelper_real.exe")
        if os.path.isfile(real) and os.path.getsize(real) > WRAPPER_MAX_SIZE:
            shutil.move(real, target)


# --------------------------------------------------------------------------- steam / vdf
def parse_vdf(text):
    """Minimal Valve KeyValues parser (enough for appmanifest/loginusers/libraryfolders)."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    stack = [{}]
    key = None
    for s, b in tokens:
        if b == "{":
            new = {}
            stack[-1][key] = new
            stack.append(new)
            key = None
        elif b == "}":
            stack.pop()
        else:
            if key is None:
                key = s
            else:
                stack[-1][key] = s
                key = None
    return stack[0]


def steam_libraries(steamapps):
    libs = [steamapps] if os.path.isdir(steamapps) else []
    lf = os.path.join(steamapps, "libraryfolders.vdf")
    if os.path.exists(lf):
        try:
            with open(lf, errors="replace") as f:
                data = parse_vdf(f.read()).get("libraryfolders", {})
            for v in data.values():
                if isinstance(v, dict) and v.get("path"):
                    p = v["path"]
                    if p.startswith("C:\\") or p.startswith("c:\\"):
                        p = os.path.join(PREFIX, "drive_c", p[3:].replace("\\", "/"))
                    p = os.path.join(p, "steamapps")
                    if os.path.isdir(p) and os.path.realpath(p) not in map(os.path.realpath, libs):
                        libs.append(p)
        except OSError:
            pass
    return libs


def installed_games(steamapps):
    games = []
    for lib in steam_libraries(steamapps):
        if not os.path.isdir(lib):
            continue
        for fn in sorted(os.listdir(lib)):
            if fn.startswith("appmanifest_") and fn.endswith(".acf"):
                try:
                    with open(os.path.join(lib, fn), errors="replace") as f:
                        st = parse_vdf(f.read()).get("AppState", {})
                except OSError:
                    continue
                flags = int(st.get("StateFlags", "0") or 0)
                games.append({
                    "appid": st.get("appid", fn[12:-4]),
                    "name": st.get("name", "?"),
                    "size": int(st.get("SizeOnDisk", "0") or 0),
                    "ready": flags == 4,
                    "flags": flags,
                    "needs_update": bool(flags & (2 | 256 | 1024)) or flags not in (4,),
                    "library": lib,
                    "installdir": st.get("installdir", ""),
                })
    return games


def all_games():
    out = []
    if steam_installed():
        for g in installed_games(os.path.join(STEAM_DIR, "steamapps")):
            g["where"] = "windows"
            out.append(g)
    if os.path.isdir(os.path.join(NATIVE_STEAM_DIR, "steamapps")):
        for g in installed_games(os.path.join(NATIVE_STEAM_DIR, "steamapps")):
            g["where"] = "mac"
            out.append(g)
    return out


def find_game(query, games):
    q = query.strip().lower()
    exact = [g for g in games if g["appid"] == q or g["name"].lower() == q]
    if exact:
        return exact[0]
    subs = [g for g in games if q in g["name"].lower()]
    if len(subs) == 1:
        return subs[0]
    if not subs:
        return None
    print("  Which one?")
    for i, g in enumerate(subs, 1):
        print(f"    {i}. {g['name']}  ({g['where']}, {g['appid']})")
    try:
        pick = int(input("  > ")) - 1
        return subs[pick]
    except (ValueError, IndexError, EOFError):
        return None


def loginusers_path(where):
    base = STEAM_DIR if where == "windows" else NATIVE_STEAM_DIR
    return os.path.join(base, "config", "loginusers.vdf")


def steam_accounts(where):
    p = loginusers_path(where)
    if not os.path.exists(p):
        return {}
    with open(p, errors="replace") as f:
        return parse_vdf(f.read()).get("users", {})


def steam_connection_state():
    """Last state in Steam's connection_log.txt ("Logged On", "Disconnected", "Connecting", ...); None if unknown."""
    try:
        with open(os.path.join(STEAM_DIR, "logs", "connection_log.txt"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode(errors="replace")
    except OSError:
        return None
    states = re.findall(r"^\[[^\]]+\] \[([A-Za-z ]+?),", tail, re.M)
    return states[-1] if states else None


def wants_offline(where="windows"):
    p = loginusers_path(where)
    try:
        with open(p, errors="replace") as f:
            return re.search(r'"WantsOfflineMode"\s+"1"', f.read()) is not None
    except OSError:
        return False


def wait_for_steam_logon(timeout=45):
    """After the Mac sleeps, Steam takes a while to reconnect. Launching a game before it is logged on makes
    Steam's controller-config / cloud sync fail and it then waits on a dialog ("Launching...") that nobody
    sees behind the game. Wait a little for "Logged On" (skipped in offline mode)."""
    if wants_offline() or steam_connection_state() in (None, "Logged On"):
        return True
    info("Steam is not connected yet (" + str(steam_connection_state()) + "); waiting for it to log on")
    for _ in range(timeout // 2):
        time.sleep(2)
        if steam_connection_state() == "Logged On":
            return True
    warn("Steam still is not logged on; launching anyway (if Steam shows a 'Launching...' dialog, answer it)")
    return False


def steam_launch_prompt(appid):
    """True if Steam's console log shows a launch of this app stuck waiting for the user (a dialog)."""
    try:
        with open(os.path.join(STEAM_DIR, "logs", "console_log.txt"), "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode(errors="replace")
    except OSError:
        return False
    last = [l for l in tail.splitlines() if f"GameAction [AppID {appid}," in l]
    return bool(last) and "waiting for user response" in last[-1]


def set_offline_mode(where, offline):
    """Flip Steam's remembered 'WantsOfflineMode' so it boots straight into offline mode."""
    p = loginusers_path(where)
    if not os.path.exists(p):
        return False
    with open(p, errors="replace") as f:
        text = f.read()
    if '"WantsOfflineMode"' not in text:
        return False
    val = "1" if offline else "0"
    text = re.sub(r'("WantsOfflineMode"\s+")\d(")', rf'\g<1>{val}\2', text)
    text = re.sub(r'("SkipOfflineModeWarning"\s+")\d(")', rf'\g<1>{val}\2', text)
    with open(p, "w") as f:
        f.write(text)
    return True


# --------------------------------------------------------------------------- controller
def xbox_controllers():
    """Return list of dicts for connected Xbox controllers (USB or Bluetooth)."""
    found = []
    # USB (wired USB-C). macOS 15+ has a native driver for wired Xbox pads.
    r = run(["system_profiler", "SPUSBDataType", "-json"])
    try:
        data = json.loads(r.stdout or "{}")
    except ValueError:
        data = {}

    def walk(items):
        for it in items or []:
            name = it.get("_name", "")
            vid = it.get("vendor_id", "")
            if "Xbox" in name or "Controller" in name and ("0x045e" in vid.lower() or "Microsoft" in it.get("manufacturer", "")):
                found.append({"name": name, "link": "USB", "battery": None})
            walk(it.get("_items"))
    walk(data.get("SPUSBDataType"))

    # Bluetooth
    r = run(["system_profiler", "SPBluetoothDataType", "-json"])
    try:
        bt = json.loads(r.stdout or "{}").get("SPBluetoothDataType", [{}])[0]
    except (ValueError, IndexError):
        bt = {}
    for entry in bt.get("device_connected", []) or []:
        for name, props in entry.items():
            minor = (props.get("device_minorType") or "").lower()
            vid = (props.get("device_vendorID") or "").lower()
            if "xbox" in name.lower() or "gamepad" in minor or vid == "0x045e":
                lvl = props.get("device_batteryLevelMain") or props.get("device_batteryLevel")
                found.append({"name": name, "link": "Bluetooth", "battery": lvl})
    return found


def paired_but_disconnected():
    r = run(["system_profiler", "SPBluetoothDataType", "-json"])
    try:
        bt = json.loads(r.stdout or "{}").get("SPBluetoothDataType", [{}])[0]
    except (ValueError, IndexError):
        return []
    names = []
    for entry in bt.get("device_not_connected", []) or []:
        for name, props in entry.items():
            minor = (props.get("device_minorType") or "").lower()
            vid = (props.get("device_vendorID") or "").lower()
            if "xbox" in name.lower() or "gamepad" in minor or vid == "0x045e":
                names.append(name)
    return names


def bluetooth_on():
    out = sh(["system_profiler", "SPBluetoothDataType"])
    m = re.search(r"State:\s*(\w+)", out)
    return (m.group(1).lower() == "on") if m else None


