            # make is a no-op when d3d12.dll is newer than its sources
            subprocess.run(["make", "-s", "-C", D3D12_SHIM_SRC_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(D3D12_SHIM_DLL) and os.path.getsize(D3D12_SHIM_DLL) > 0 and not _same_content(D3D12_SHIM_DLL, D3D12_SHIM_INSTALLED):
            replace_file(D3D12_SHIM_DLL, D3D12_SHIM_INSTALLED)
    except PermissionError:
        pass
    return D3D12_SHIM_INSTALLED if os.path.exists(D3D12_SHIM_INSTALLED) else None


