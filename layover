# --------------------------------------------------------------------------- helpers
class C:
    B = "\033[1m"; G = "\033[32m"; Y = "\033[33m"; R = "\033[31m"; D = "\033[2m"; X = "\033[0m"


JSON_MODE = False   # set by main() for `--json` runs: stdout carries one JSON document, messages go to stderr


def tty():
    return sys.stdout.isatty()


def _out():
    return sys.stderr if JSON_MODE else sys.stdout


def paint(s, col):
    return f"{col}{s}{C.X}" if tty() else s


def ok(msg): print(paint("  ✓ ", C.G) + msg, file=_out())
def warn(msg): print(paint("  ! ", C.Y) + msg, file=_out())
def bad(msg): print(paint("  ✗ ", C.R) + msg, file=_out())
def info(msg): print(paint("  · ", C.D) + msg, file=_out())
def head(msg): print("\n" + paint(msg, C.B), file=_out())


def die(msg, code=1):
    """Exit codes: 1 error, 3 not found / not installed, 4 Steam needs the user, 5 not set up, 6 Steam must be closed."""
    if JSON_MODE:
        print(json.dumps({"ok": False, "error": msg, "code": code}))
    else:
        bad(msg)
    sys.exit(code)


def emit(payload):
    """The result document of an action in `--json` mode (nothing otherwise: the human lines were printed)."""
    if JSON_MODE:
        print(json.dumps(payload))


def run(cmd, **kw):
    kw.setdefault("text", True)
    kw.setdefault("capture_output", True)
    return subprocess.run(cmd, **kw)


def sh(cmd):
    r = run(cmd)
    return r.stdout.strip()


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


