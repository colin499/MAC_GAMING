# Verdict per game, from (a) the installed files (graphics API imports, anti-cheat components, launcher exes),
# (b) Steam's app info (OS list, Steam Deck rating) and (c) optional online lookups (Steam store page text,
# ProtonDB tier) cached 7 days in cache/compat/<appid>.json. `layover library` only reads the cache.
ANTICHEAT_MARKERS = {   # folder / file names (lowercase) -> product; kernel-level anti-cheat never runs under Wine
    "easyanticheat": "Easy Anti-Cheat", "easyanticheat_x64.dll": "Easy Anti-Cheat", "easyanticheat_eos_setup.exe": "Easy Anti-Cheat",
    "battleye": "BattlEye", "beclient_x64.dll": "BattlEye", "beservice.exe": "BattlEye", "beservice_x64.exe": "BattlEye",
    "vgc.exe": "Riot Vanguard", "vgk.sys": "Riot Vanguard", "gameguard.des": "nProtect GameGuard", "x3.xem": "XIGNCODE3",
    "xigncode": "XIGNCODE3", "pbsvc.exe": "PunkBuster", "pbsvc_x64.exe": "PunkBuster",
}
ANTICHEAT_WORDS = ("Easy Anti-Cheat", "EasyAntiCheat", "BattlEye", "Vanguard", "Ricochet", "nProtect", "GameGuard", "XIGNCODE", "PunkBuster")
EXE_NEEDLES = {"d3d12": b"d3d12.dll", "d3d11": b"d3d11.dll", "d3d10": b"d3d10.dll", "d3d9": b"d3d9.dll",
               "vulkan": b"vulkan-1.dll", "opengl": b"opengl32.dll", "dotnet": b"mscoree.dll"}
DECK_NAMES = {1: "Unsupported", 2: "Playable", 3: "Verified"}


def game_root(game):
    """steamapps/common/<installdir> of an installed game, or None."""
    lib = game.get("library")
    installdir = game.get("installdir")
    if not lib or not installdir:
        return None
    root = os.path.join(lib, "common", installdir) if lib.endswith("steamapps") else os.path.join(os.path.dirname(lib), "steamapps", "common", installdir)
    return root if os.path.isdir(root) else None


def scan_game_binaries(game):
    """What the installed files say: graphics APIs imported by the executables (whole files are read: Spider-Man
    2's import table sits past 140 MB), anti-cheat components, launcher executables. None if the folder is missing."""
    root = game_root(game)
    if not root:
        return None
    hits = {k: False for k in EXE_NEEDLES}
    hits.update({"anticheat": set(), "launcher_exes": [], "exes": 0})
    for dirpath, dirs, files in os.walk(root):
        if dirpath[len(root):].count(os.sep) > 2:
            dirs[:] = []
            continue
        for d in dirs:
            low = d.lower()
            if low == "d3d12":                      # DirectX 12 Agility SDK ships here
                hits["d3d12"] = True
            if low in ANTICHEAT_MARKERS:
                hits["anticheat"].add(ANTICHEAT_MARKERS[low])
        for fn in files:
            low = fn.lower()
            if low in ANTICHEAT_MARKERS:
                hits["anticheat"].add(ANTICHEAT_MARKERS[low])
            if low.endswith("_dx12.dll") or low == "d3d12core.dll":
                hits["d3d12"] = True
            if not low.endswith(".exe"):
                continue
            hits["exes"] += 1
            if "launcher" in low:
                hits["launcher_exes"].append(fn)
            fp = os.path.join(dirpath, fn)
            try:
                if os.path.getsize(fp) < 512 * 1024:
                    continue
                with open(fp, "rb") as f:
                    tail = b""
                    while True:
                        chunk = f.read(16 << 20)
                        if not chunk:
                            break
                        blob = (tail + chunk).lower()
                        for key, needle in EXE_NEEDLES.items():
                            if not hits[key] and needle in blob:
                                hits[key] = True
                        tail = chunk[-16:]
            except OSError:
                continue
    hits["anticheat"] = sorted(hits["anticheat"])
    return hits


def read_compat_cache(appid):
    try:
        with open(compat_cache_path(appid)) as f:
            c = json.load(f)
        return c if isinstance(c, dict) else {}
    except (OSError, ValueError):
        return {}


def write_compat_cache(appid, cache):
    try:
        os.makedirs(COMPAT_DIR, exist_ok=True)
        with open(compat_cache_path(appid) + ".tmp", "w") as f:
            json.dump(cache, f)
        os.replace(compat_cache_path(appid) + ".tmp", compat_cache_path(appid))
    except OSError:
        pass


def local_scan(game, refresh=False):
    """scan_game_binaries() once per build of the game, remembered in the compat cache."""
    cache = read_compat_cache(game["appid"])
    build = game.get("buildid") or ""
    if not refresh and cache.get("local") is not None and cache.get("local_buildid") == build:
        return cache["local"]
    local = scan_game_binaries(game)
    if local is not None:
        cache["local"] = local
        cache["local_buildid"] = build
        write_compat_cache(game["appid"], cache)
    return local


def game_uses_dx12(game):
    """Does this game need DirectX 12? From the install's executables (see scan_game_binaries); cached per build."""
    local = local_scan(game)
    if not local:
        return None
    if local["d3d12"]:
        return True
    if local["d3d11"]:
        return False
    return None


def fetch_json(url, timeout=8):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=timeout) as r:
            return json.load(r)
    except (OSError, ValueError):
        return None


def store_details(appid):
    """Steam store facts (public API, no key): Windows platform, DirectX version named in the requirements,
    anti-cheat / DRM names in the notices. {"missing": True} for an unlisted app, None when offline."""
    d = fetch_json(f"https://store.steampowered.com/api/appdetails?appids={appid}&filters=categories,pc_requirements,platforms,drm_notice,name")
    if not isinstance(d, dict):
        return None
    e = d.get(str(appid)) or {}
    if not e.get("success"):
        return {"missing": True}
    data = e.get("data") or {}
    req = data.get("pc_requirements") or {}
    text = " ".join(str(v) for v in (req.values() if isinstance(req, dict) else [])) + " " + str(data.get("drm_notice") or "")
    text = re.sub(r"<[^>]+>", " ", text)
    m = re.search(r"DirectX\D{0,24}?(9|10|11|12)\b", text, re.I)
    low = text.lower()
    return {"name": data.get("name"), "windows": bool((data.get("platforms") or {}).get("windows", True)),
            "directx": int(m.group(1)) if m else None, "categories": [c.get("description", "") for c in data.get("categories") or []],
            "anticheat": sorted({w for w in ANTICHEAT_WORDS if w.lower() in low}), "denuvo": "denuvo" in low}


def protondb_summary(appid):
    """ProtonDB's community tier (unofficial endpoint; absent when it fails): a good proxy for Wine in general."""
    d = fetch_json(f"https://www.protondb.com/api/v1/reports/summaries/{appid}.json")
    if not isinstance(d, dict) or not d.get("tier"):
        return None
    return {"tier": d.get("tier"), "confidence": d.get("confidence"), "total": d.get("total"),
            "trending": d.get("trendingTier"), "best": d.get("bestReportedTier")}


def compat_verdict(info, local, store, pdb):
    """Combine the signals into {verdict, label, reasons, unverified, checked}. First blocker wins."""
    reasons = []
    verdict = None
    store = store if isinstance(store, dict) and not store.get("missing") else None
    ac = set((local or {}).get("anticheat") or []) | set((store or {}).get("anticheat") or [])
    if ac:
        verdict = "wont_run"
        reasons.append("anti-cheat: " + ", ".join(sorted(ac)) + " (kernel-level anti-cheat does not run under Wine)")
    osl = info.get("oslist") or ""
    if (osl and "windows" not in osl) or (store and store.get("windows") is False):
        verdict = verdict or "wont_run"
        reasons.append("no Windows build" + (f" (Steam lists: {osl})" if osl else ""))
    tier = (pdb or {}).get("tier")
    if tier:
        reasons.append(f"ProtonDB: {tier}" + (f" ({pdb.get('total')} reports)" if pdb.get("total") else "") + " (Linux Proton, same Wine code)")
        if verdict is None and tier == "borked":
            verdict = "likely_issues"
    deck = info.get("deck_category")
    if deck in DECK_NAMES:
        reasons.append("Steam Deck " + DECK_NAMES[deck] + " (Valve's own Proton rating)")
    if local:
        if local.get("d3d12"):
            reasons.append("DirectX 12 (D3DMetal; performance varies by game)")
        elif local.get("d3d11"):
            reasons.append("DirectX 11 (DXMT; generally good)")
        elif local.get("d3d10") or local.get("d3d9"):
            reasons.append("DirectX 9/10 only: no DXMT/D3DMetal path, Wine's slow OpenGL fallback (wined3d)")
            verdict = verdict or "likely_issues"
        elif local.get("vulkan"):
            reasons.append("Vulkan (MoltenVK)")
        elif local.get("opengl"):
            reasons.append("OpenGL")
        else:
            reasons.append("no graphics API imports found in the executables")
        if local.get("dotnet"):
            reasons.append(".NET runtime used (Wine needs the right redistributable; Steam usually installs it)")
        if local.get("launcher_exes"):
            reasons.append("starts through a launcher window: " + ", ".join(local["launcher_exes"][:3]) + " (needs a click; a controller alone cannot)")
        if verdict is None:
            verdict = "varies" if local.get("d3d12") else ("should_work" if (local.get("d3d11") or local.get("vulkan")) else "unknown")
    else:
        dx = (store or {}).get("directx")
        if dx:
            reasons.append(f"store page lists DirectX {dx}")
            if dx <= 10:
                verdict = verdict or "likely_issues"
        if verdict is None:
            if tier in ("platinum", "gold") or deck == 3:
                verdict = "should_work"
            elif tier == "silver" or deck == 2 or dx == 12:
                verdict = "varies"
            elif tier == "bronze" or deck == 1:
                verdict = "likely_issues"
            elif dx == 11:
                verdict = "should_work"
            else:
                verdict = "unknown"
        if not local and info.get("type") != "unknown":
            reasons.append("not installed: install it for a check of the actual files")
    if (store or {}).get("denuvo"):
        reasons.append("Denuvo DRM (runs under Wine; counts hardware activations)")
    if info.get("launch_options"):
        reasons.append("Steam launch options set: " + info["launch_options"])
    online = bool(store or pdb)
    return {"verdict": verdict, "label": COMPAT_LABELS[verdict], "reasons": reasons, "unverified": not online,
            "checked": time.time() if online else None}


def compute_compat(cfg, appid, refresh=False, online=None):
    """Recompute one game's verdict (scans installed files once per build, asks the store/ProtonDB at most
    weekly when online_lookups is on). Returns (verdict, cache)."""
    appid = str(appid)
    info = find_owned(appid) or {"appid": appid, "name": f"App {appid}", "type": "unknown"}
    installed = next((g for g in all_games() if g["appid"] == appid and g["where"] == "windows"), None)
    cache = read_compat_cache(appid)
    local = None
    if installed:
        local = local_scan(installed, refresh=refresh)
        cache = read_compat_cache(appid)
        if local and (local["d3d12"] or local["d3d11"]):
            g = cfg["games"].setdefault(appid, {})
            if g.get("dx12") != bool(local["d3d12"]):
                g["dx12"] = bool(local["d3d12"])
                save_config(cfg)
    want_online = cfg.get("online_lookups", True) if online is None else online
    stale = time.time() - (cache.get("online_checked") or 0) > 7 * 86400
    if want_online and (refresh or stale):
        store = store_details(appid)
        time.sleep(0.3)   # the store API allows ~200 calls per 5 minutes
        pdb = protondb_summary(appid)
        if store is not None:
            cache["store"] = store
        if pdb is not None:
            cache["protondb"] = pdb
        if store is not None or pdb is not None:
            cache["online_checked"] = time.time()
    v = compat_verdict(info, local, cache.get("store"), cache.get("protondb"))
    cache["verdict"] = v
    cache["name"] = info.get("name")
    write_compat_cache(appid, cache)
    return v, cache


def cmd_compat(args):
    """Will this game run? Verdict with reasons; `--refresh` re-scans and asks the store/ProtonDB again."""
    cfg = load_config()
    if args.all:
        ids = [g["appid"] for g in owned_games(include_free=args.include_free)]
    elif args.appid:
        ids = []
        for q in args.appid:
            o = find_owned(q) or find_any_game(q)
            if not o:
                die(f"no game matches '{q}' (layover library)", 3)
            ids.append(o["appid"])
    else:
        die("usage: layover compat <game> [--refresh] | --all", 2)
    results = {}
    for appid in ids:
        v, cache = compute_compat(cfg, appid, refresh=args.refresh, online=False if args.offline else None)
        results[appid] = {"compat": v, "local": cache.get("local"), "store": cache.get("store"), "protondb": cache.get("protondb"), "name": cache.get("name")}
        if not JSON_MODE:
            colour = {"should_work": C.G, "varies": C.Y, "likely_issues": C.Y, "wont_run": C.R}.get(v["verdict"], C.D)
            head(f"{cache.get('name') or appid}  ·  " + paint(v["label"], colour) + ("" if not v["unverified"] else "  (local facts only; no store/ProtonDB data)"))
            for r in v["reasons"]:
                info(r)
    if JSON_MODE:
        print(json.dumps({"ok": True, "results": results}))


