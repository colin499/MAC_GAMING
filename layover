def cmd_uninstall(args):
    if not os.path.isdir(ROOT):
        info("nothing installed")
        return
    size = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(ROOT) for f in fs if os.path.exists(os.path.join(r, f)))
    warn(f"this deletes {ROOT} ({human(size)}) including Steam and every installed game in it")
    if not args.yes:
        try:
            if input("  type 'delete' to confirm: ").strip() != "delete":
                info("cancelled")
                return
        except EOFError:
            return
    if engine_ready():
        wineserver_kill(load_config())
        time.sleep(1)
    shutil.rmtree(ROOT, ignore_errors=True)
    ok("removed")


# --------------------------------------------------------------------------- the Finder app
APP_DIR = os.path.expanduser("~/Applications/Layover.app")
APP_SRC_ICON = os.path.join(HERE, "app", "Layover.icns")


def osa(script):
    """Run AppleScript, return its stdout (empty string if the user cancelled)."""
    r = run(["osascript", "-e", script])
    return r.stdout.strip() if r.returncode == 0 else ""


def notify(title, text):
    run(["osascript", "-e", f'display notification "{text}" with title "{title}"'])


def cmd_app(args):
    """Build ~/Applications/Layover.app: a double-clickable app (no Terminal) that launches a game."""
    macos = os.path.join(APP_DIR, "Contents", "MacOS"); res = os.path.join(APP_DIR, "Contents", "Resources")
    os.makedirs(macos, exist_ok=True); os.makedirs(res, exist_ok=True)
    with open(os.path.join(APP_DIR, "Contents", "Info.plist"), "w") as f:
        f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Layover</string>
  <key>CFBundleDisplayName</key><string>Layover</string>
  <key>CFBundleIdentifier</key><string>local.layover.launcher</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>Layover</string>
  <key>CFBundleIconFile</key><string>Layover</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
""")
    launcher = os.path.join(macos, "Layover")
    with open(launcher, "w") as f:
        f.write(f"""#!/bin/zsh
# Layover.app: launches `layover app-launch` from the repo without a Terminal window.
# Any python3 will do (the program only uses the standard library): Homebrew's if present, else Apple's.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
for py in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  [ -x "$py" ] && exec "$py" "{os.path.join(HERE, 'layover')}" app-launch >> "{os.path.join(LOGS, 'app.log')}" 2>&1
done
osascript -e 'display dialog "Layover needs python3 (install the Xcode Command Line Tools or Homebrew python)." buttons {{"OK"}} with icon stop'
""")
    os.chmod(launcher, 0o755)
    if os.path.exists(APP_SRC_ICON):
        shutil.copy2(APP_SRC_ICON, os.path.join(res, "Layover.icns"))
    run(["touch", APP_DIR])   # make Finder notice the icon
    ok(f"{APP_DIR} built (double-click it, or Spotlight → Layover)")
    info("it lists your installed Windows games and launches the one you pick; Steam starts on its own if needed")


def cmd_app_launch(args):
    """What Layover.app runs: pick a game in a dialog, then play it. Errors go to a dialog, not a terminal."""
    try:
        app_log = os.path.join(LOGS, "app.log")
        if os.path.exists(app_log) and os.path.getsize(app_log) > (1 << 20):
            open(app_log, "w").close()   # the launcher appends forever; start over past 1 MB
    except OSError:
        pass
    try:
        cfg = load_config()
        if not (engine_ready() and steam_installed()):
            osa('display dialog "Layover is not set up yet. Open Terminal in the MAC_GAMING folder and run:  ./layover setup" buttons {"OK"} default button 1 with icon stop')
            return
        games = [g for g in all_games() if g["where"] == "windows"]
        games.sort(key=lambda g: g["name"].lower())
        names = [g["name"] for g in games if g["ready"]]
        items = names + ["Open Steam", "Quit Steam"]
        lst = ", ".join('"' + n.replace('"', "'") + '"' for n in items)
        default = '"' + (names[0].replace('"', "'") if names else "Open Steam") + '"'
        pick = osa(f'choose from list {{{lst}}} with title "Layover" with prompt "What do you want to play?" default items {{{default}}} OK button name "Launch"')
        if not pick or pick == "false":
            return
        if pick == "Open Steam":
            cmd_steam(argparse.Namespace(offline=False, online=False, extra=[]))
            notify("Layover", "Steam is starting")
            return
        if pick == "Quit Steam":
            cmd_kill(argparse.Namespace())
            notify("Layover", "Steam closed")
            return
        g = next((g for g in games if g["name"].replace('"', "'") == pick), None)
        if not g:
            die(f"game '{pick}' not found")
        notify("Layover", f"Launching {g['name']}" + ("" if steam_running() else " (starting Steam first, about 20 s)"))
        cmd_play(argparse.Namespace(game=g["appid"], offline=False))
    except SystemExit as e:
        if e.code not in (0, None):
            osa(f'display dialog "Layover could not launch that. See {LOGS}/app.log" buttons {{"OK"}} default button 1 with icon stop')
        raise
    except Exception as e:
        msg = str(e).replace('"', "'")[:300]
        osa(f'display dialog "Layover hit an error: {msg}" buttons {{"OK"}} default button 1 with icon stop')
        raise


def cmd_menu(args):
    items = [
        ("Launch Steam (Windows games)", lambda: cmd_steam(argparse.Namespace(offline=False, online=False, extra=[]))),
        ("Launch Steam OFFLINE (on the plane)", lambda: cmd_steam(argparse.Namespace(offline=True, online=False, extra=[]))),
        ("List installed games", lambda: cmd_games(None)),
        ("Play a game", lambda: cmd_play(argparse.Namespace(game=input("  game name: "), offline=False))),
        ("Controller check", lambda: cmd_controller(argparse.Namespace(test=False, seconds=15, open_settings=False))),
        ("Controller input test (15 s)", lambda: cmd_controller(argparse.Namespace(test=True, seconds=15, open_settings=False))),
        ("Pre-flight checklist", lambda: cmd_flight(argparse.Namespace(go=False, set_offline=False, online=False))),
        ("Pre-flight + set offline + launch", lambda: cmd_flight(argparse.Namespace(go=True, set_offline=True, online=False))),
        ("Back online (after the flight)", lambda: cmd_flight(argparse.Namespace(go=False, set_offline=False, online=True))),
        ("Doctor (health check)", lambda: cmd_doctor(None)),
        ("Setup / repair", lambda: cmd_setup(argparse.Namespace(reinstall=False, d3dmetal=False, no_launch=True))),
        ("Stop Steam", lambda: cmd_kill(None)),
    ]
    while True:
        head(f"✈  {APP_NAME}")
        for i, (label, _) in enumerate(items, 1):
            print(f"  {i:>2}. {label}")
        print("   q. quit")
        try:
            choice = input("\n  > ").strip().lower()
        except EOFError:
            return
        if choice in ("q", "quit", "exit", ""):
            return
        if choice.isdigit() and 1 <= int(choice) <= len(items):
            try:
                items[int(choice) - 1][1]()
            except SystemExit:
                pass
            except KeyboardInterrupt:
                print()
        else:
            warn("pick a number")


# --------------------------------------------------------------------------- main
def main(argv=None):
    p = argparse.ArgumentParser(prog="layover", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"{APP_NAME} {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("setup", help="install engine, renderers, Windows Steam (needs internet)")
    s.add_argument("--reinstall", action="store_true", help="redo every step")
    s.add_argument("--d3dmetal", action="store_true", help=argparse.SUPPRESS)  # kept for old scripts; D3DMetal is always installed now
    s.add_argument("--no-launch", action="store_true", help="don't offer to launch Steam at the end")
    s.set_defaults(fn=cmd_setup)

    s = sub.add_parser("steam", help="launch Windows Steam")
    s.add_argument("--offline", action="store_true", help="start in offline mode")
    s.add_argument("--online", action="store_true", help="start in online mode")
    s.add_argument("extra", nargs="*", help="extra steam.exe arguments")
    s.set_defaults(fn=cmd_steam)

    sub.add_parser("games", help="list installed games (Windows prefix + native Mac Steam)").set_defaults(fn=cmd_games)
    sub.add_parser("update-steam", help="let the Steam client update itself (normal launches skip this)").set_defaults(fn=cmd_update_steam)

    s = sub.add_parser("play", help="launch a game by name or AppID")
    s.add_argument("game")
    s.add_argument("--offline", action="store_true", help="start Steam offline if it isn't running")
    s.set_defaults(fn=cmd_play)

    s = sub.add_parser("install", help="start downloading a game by Steam AppID")
    s.add_argument("appid")
    s.set_defaults(fn=cmd_install)

    s = sub.add_parser("controller", help="detect / pair / test the Xbox controller")
    s.add_argument("--test", action="store_true", help="live input test using Apple's GameController framework")
    s.add_argument("--seconds", type=int, default=15)
    s.add_argument("--open-settings", action="store_true", help="open Bluetooth settings")
    s.set_defaults(fn=cmd_controller)

    s = sub.add_parser("flight", help="pre-flight checklist, offline mode, launch")
    s.add_argument("--set-offline", action="store_true", help="switch both Steams to offline mode (restarts Steam if open)")
    s.add_argument("--go", action="store_true", help="set offline and launch Steam")
    s.add_argument("--online", action="store_true", help="switch Steam back to online mode")
    s.set_defaults(fn=cmd_flight)

    s = sub.add_parser("renderer", help="show or set the graphics backend (default or per game)")
    s.add_argument("game", nargs="?", help="game name/AppID, or 'default'")
    s.add_argument("renderer", nargs="?", choices=RENDERER_CHOICES)
    s.set_defaults(fn=lambda a: cmd_renderer(a) if (a.game is None or a.renderer) else die("usage: layover renderer <game|default> <dxmt|wined3d|d3dmetal>"))

    s = sub.add_parser("config", help="show or change a setting (msync, metal_hud, advertise_avx, retina, steam_overlay, fps_cap, steam_args, d3dmetal_identity)")
    s.add_argument("key", nargs="?")
    s.add_argument("value", nargs="?", help="for steam_args, quote the whole list, e.g. \"-cef-disable-gpu -noverifyfiles\"")
    s.set_defaults(fn=lambda a: cmd_config(a) if (a.key is None or a.value is not None) else die("usage: layover config <key> <value>"))

    sub.add_parser("doctor", help="health check").set_defaults(fn=cmd_doctor)
    sub.add_parser("kill", help="stop Steam and the Windows prefix").set_defaults(fn=cmd_kill)
    sub.add_parser("quit", help="same as kill: fully quit Steam (closing its window only hides it)").set_defaults(fn=cmd_kill)
    sub.add_parser("logs", help="show the latest launch log").set_defaults(fn=cmd_logs)
    sub.add_parser("winecfg", help="open Wine's settings window for the prefix").set_defaults(fn=cmd_winecfg)
    s = sub.add_parser("uninstall", help="remove Layover and everything it installed")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_uninstall)
    sub.add_parser("app", help="build ~/Applications/Layover.app (double-click to play, no Terminal)").set_defaults(fn=cmd_app)
    sub.add_parser("app-launch", help=argparse.SUPPRESS).set_defaults(fn=cmd_app_launch)
    sub.add_parser("menu", help="interactive menu").set_defaults(fn=cmd_menu)
    sub.add_parser("help", help="show help").set_defaults(fn=lambda a: p.print_help())

    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) >= 3 and argv[0] == "config" and argv[2].startswith("-"):
        argv.insert(2, "--")   # let values like "-cef-disable-gpu" through argparse
    args = p.parse_args(argv)
    if not args.cmd:
        cmd_menu(args) if tty() else p.print_help()
        return
    try:
        args.fn(args)
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
