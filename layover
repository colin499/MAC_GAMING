            os.path.isdir(os.path.join(ENGINE_RENDERERS, "d3dmetal", "external", "D3DMetal.framework"))
    return False


def _same_content(a, b):
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        return sha256(a) == sha256(b)
    except OSError:
        return False


def replace_file(src, dst):
    """Copy src over dst atomically (temp file + rename). A game that has the old dst mapped keeps
    running on the old inode instead of seeing its code change under it."""
    tmp = dst + ".new"
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def _same_file(a, b):
    try:
        with open(a, "rb") as fa, open(b, "rb") as fb:
            return fa.read(1 << 16) == fb.read(1 << 16)
    except OSError:
        return False


def assemble_engine():
    """Download (cached) and lay out the engine the way Highball's installer does:
         engines/<id>/engine/        Wine (bin, lib, share)  [+ patched wineserver, ntdll.so, winemac.so]
         engines/<id>/frameworks/    runtime dylibs, GStreamer, MoltenVK, audiobuf
         engines/<id>/renderers/     dxmt/wine, d3dmetal/{wine,external}
    """
    paths = {}
    for key, comp in COMPONENTS.items():
        paths[key] = download(comp["url"], os.path.join(CACHE, os.path.basename(comp["url"])), comp["sha256"], comp["label"])
    staging = ENGINE_DIR + ".partial"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(os.path.join(staging, "renderers"), exist_ok=True)
    info("unpacking the engine (about a minute)")
    for key in COMPONENTS:
        extract(paths[key], os.path.join(staging, ".x-" + key))
    x = lambda key, *rest: os.path.join(staging, ".x-" + key, *rest)
    # Wine (Sikarugir engine tarballs wrap it in wswine.bundle/)
    shutil.move(x("wine", "wswine.bundle"), os.path.join(staging, "engine"))
    # runtime frameworks (+ D3DMetal) from the Sikarugir template
    tpl = next(d for d in os.listdir(x("runtime")) if d.endswith(".app"))
    shutil.move(x("runtime", tpl, "Contents", "Frameworks"), os.path.join(staging, "frameworks"))
    d3dm = os.path.join(staging, "frameworks", "renderer", "d3dmetal")
    if os.path.isdir(d3dm):
        shutil.move(d3dm, os.path.join(staging, "renderers", "d3dmetal"))
    shutil.rmtree(os.path.join(staging, "frameworks", "renderer"), ignore_errors=True)
    i386 = os.path.join(staging, "renderers", "d3dmetal", "wine", "i386-windows")
    if os.path.islink(i386):
        os.remove(i386)   # pointed at a sibling renderer we dropped; 32-bit D3DMetal is not a thing anyway
    # DXMT (Highball fork)
    os.makedirs(os.path.join(staging, "renderers", "dxmt"), exist_ok=True)
    shutil.move(x("dxmt", "highball"), os.path.join(staging, "renderers", "dxmt", "wine"))
    # patched MoltenVK, audio buffer library, msync fix, Mac driver fix
    shutil.copy2(x("moltenvk", "libMoltenVK.dylib"), os.path.join(staging, "frameworks", "libMoltenVK.dylib"))
    shutil.copy2(x("audiobuf", "libhbaudiobuf.dylib"), os.path.join(staging, "frameworks", "libhbaudiobuf.dylib"))
    shutil.copy2(x("msync", "wineserver"), os.path.join(staging, "engine", "bin", "wineserver"))
    shutil.copy2(x("msync", "ntdll.so"), os.path.join(staging, "engine", "lib", "wine", "x86_64-unix", "ntdll.so"))
    shutil.copy2(x("winemac", "winemac.so"), os.path.join(staging, "engine", "lib", "wine", "x86_64-unix", "winemac.so"))
    os.chmod(os.path.join(staging, "engine", "bin", "wineserver"), 0o755)
    # link runtime dylibs into engine/lib like Highball does (belt and braces next to DYLD fallback)
    lib = os.path.join(staging, "engine", "lib")
    for base in (os.path.join(staging, "frameworks"), os.path.join(staging, "frameworks", "GStreamer.framework", "Versions", "1.0", "lib")):
        if not os.path.isdir(base):
            continue
        rel = os.path.relpath(base, lib)
        for name in os.listdir(base):
            if name.endswith(".dylib") and not os.path.lexists(os.path.join(lib, name)):
                os.symlink(os.path.join(rel, name), os.path.join(lib, name))
    for key in COMPONENTS:
        shutil.rmtree(x(key), ignore_errors=True)
    shutil.rmtree(ENGINE_DIR, ignore_errors=True)
    os.rename(staging, ENGINE_DIR)
    run(["xattr", "-dr", "com.apple.quarantine", ENGINE_DIR])
    with open(os.path.join(ENGINE_DIR, "manifest.json"), "w") as f:
        json.dump({"id": ENGINE_ID, "components": COMPONENTS, "assembled": _dt.datetime.now().isoformat()}, f, indent=2)


