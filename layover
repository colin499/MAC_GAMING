# --------------------------------------------------------------------------- downloads
def download(url, dest, expected_sha=None, label=None):
    """Download with a progress line. Reuses the cached file if its hash matches."""
    label = label or os.path.basename(dest)
    if os.path.exists(dest) and (expected_sha is None or sha256(dest) == expected_sha):
        ok(f"{label} already downloaded")
        return dest
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    info(f"downloading {label}")
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP_NAME}/{VERSION}"})
    with urllib.request.urlopen(req) as resp, open(tmp, "wb") as f:
        total = int(resp.headers.get("Content-Length") or 0)
        got = 0
        last = 0
        while True:
            chunk = resp.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            if tty() and (time.time() - last > 0.2):
                pct = f"{got * 100 // total}%" if total else ""
                sys.stdout.write(f"\r    {human(got)} / {human(total) if total else '?'} {pct}   ")
                sys.stdout.flush()
                last = time.time()
    if tty():
        sys.stdout.write("\r" + " " * 60 + "\r")
    if expected_sha:
        actual = sha256(tmp)
        if actual != expected_sha:
            os.remove(tmp)
            die(f"{label}: checksum mismatch\n      expected {expected_sha}\n      got      {actual}\n"
                "    The upstream file changed or the download was corrupted. Not installing it.")
    os.replace(tmp, dest)
    ok(f"{label} downloaded ({human(os.path.getsize(dest))})")
    return dest


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def extract(archive, dest):
    os.makedirs(dest, exist_ok=True)
    # macOS tar handles .xz and .gz and keeps symlinks/permissions intact.
    r = run(["tar", "-xf", archive, "-C", dest])
    if r.returncode != 0:
        die(f"extract failed: {r.stderr.strip()}")


# --------------------------------------------------------------------------- renderer choice
def resolve_renderer(cfg, game=None, games=None):
    """Turn 'auto' into a concrete renderer. With a specific game: that game's need. Without
    one (plain `layover steam`): D3DMetal if any installed game needs DirectX 12, so that
    launching from inside Steam's own UI works for everything installed."""
    g = cfg["games"].get(str(game), {}) if game else {}
    choice = g.get("renderer") or cfg.get("renderer") or "auto"
    if choice != "auto":
        return choice
    games = games if games is not None else [x for x in all_games() if x["where"] == "windows"]
    targets = [x for x in games if str(x["appid"]) == str(game)] if game else games
    for x in targets:
        cached = cfg["games"].get(x["appid"], {}).get("dx12")
        if cached is None:
            cached = game_uses_dx12(x)
            if cached is not None:
                cfg["games"].setdefault(x["appid"], {})["dx12"] = cached
                save_config(cfg)
        if cached:
            return "d3dmetal"
    return "dxmt"


# --------------------------------------------------------------------------- wine plumbing
D3DMETAL_IDENTITIES = ("apple", "amd")


def registered_gpu():
    """(vendor, device, description) of the display adapter Wine registered in the prefix
    registry (HKLM\\System\\CurrentControlSet\\Enum\\PCI). Parsed from system.reg so no
    Wine process is needed. None if the prefix has not booted yet."""
    try:
        with open(os.path.join(PREFIX, "system.reg"), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    for m in re.finditer(r"^\[System\\\\(?:CurrentControlSet|ControlSet001)\\\\Enum\\\\PCI\\\\VEN_([0-9A-Fa-f]{4})&DEV_([0-9A-Fa-f]{4})[^\]]*\] \d+\n((?:[^\n]*\n)*?)\n", text, re.M):
        body = m.group(3)
        if '"Class"="Display"' not in body:
            continue
        desc = re.search(r'"DeviceDesc"="([^"]*)"', body)
        return int(m.group(1), 16), int(m.group(2), 16), (desc.group(1) if desc else "Apple GPU")
    return None


def wine_env(cfg, game=None, extra=None):
    """Environment for running anything in the Steam prefix.

    Mirrors what Highball does for this engine: runtime dylibs come from frameworks/ via the
    DYLD fallback paths, and a renderer is an overlay directory put in front of the engine's
    own DLLs with WINEDLLPATH_PREPEND (a CrossOver feature this build keeps)."""
    g = cfg["games"].get(str(game), {}) if game else {}
    renderer = (extra or {}).pop("LAYOVER_RENDERER", None) or resolve_renderer(cfg, game)
    if renderer not in RENDERER_CHOICES or renderer == "auto":
        renderer = "dxmt"
    msync = g.get("msync", cfg["msync"])
    gst = os.path.join(FRAMEWORKS, "GStreamer.framework", "Versions", "1.0")
    env = dict(os.environ)
    env.update({
        "WINEPREFIX": PREFIX,
        "WINEDEBUG": "-all",
        "WINE_LARGE_ADDRESS_AWARE": "1",
        "GST_DEBUG": "1",
        "DYLD_FALLBACK_FRAMEWORK_PATH": FRAMEWORKS,
        "DYLD_FALLBACK_LIBRARY_PATH": FRAMEWORKS + ":" + os.path.join(gst, "lib"),
        "GST_PLUGIN_PATH": os.path.join(gst, "lib", "gstreamer-1.0"),
        "CX_FWD_COMPAT_GL_CTX": "1",
        "DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN": "1",   # Steam overlay + DXMT
        "MVK_CONFIG_LOG_LEVEL": "0",
        "WINEDLLOVERRIDES": "winemenubuilder.exe=d",
        "PATH": WINE_BIN + ":" + env.get("PATH", ""),
    })
    env["WINEMSYNC"] = "1" if msync else "0"
    env["WINEESYNC"] = "0"
    audiobuf = os.path.join(FRAMEWORKS, "libhbaudiobuf.dylib")
    if cfg.get("audiobuf", True) and os.path.exists(audiobuf):
        env["DYLD_INSERT_LIBRARIES"] = audiobuf   # caps CoreAudio buffer: fixes crackling at 48 kHz
    if g.get("metal_hud", cfg["metal_hud"]):
        env["MTL_HUD_ENABLED"] = "1"
    if g.get("advertise_avx", cfg["advertise_avx"]):
        env["ROSETTA_ADVERTISE_AVX"] = "1"
    if not g.get("steam_overlay", cfg.get("steam_overlay", True)):
        env["WINEDLLOVERRIDES"] += ";gameoverlayrenderer64=d;gameoverlayrenderer=d"   # Steam can't inject its overlay
    overlays = []
    if renderer == "dxmt":
        overlays = [os.path.join(ENGINE_RENDERERS, "dxmt", "wine")]
    elif renderer == "d3dmetal":
        ext = os.path.join(ENGINE_RENDERERS, "d3dmetal", "external")
        overlays = [os.path.join(ENGINE_RENDERERS, "d3dmetal", "wine"), os.path.join(ENGINE_RENDERERS, "dxmt", "wine")]
        env["CX_D3DMETALPATH"] = ext
        env["DYLD_FALLBACK_LIBRARY_PATH"] += ":" + ext
        env["DYLD_FALLBACK_FRAMEWORK_PATH"] += ":" + ext
        if os.path.isfile(ags_shim_overlay_path()):
            env["WINEDLLOVERRIDES"] += ";amd_ags_x64=b"   # our AGS replacement beats the game's copy
        if d3d12_shim_installed() and cfg.get("d3d12_shim", True):
            overlays.insert(0, D3D12_SHIM_OVERLAY)
            env["WINEDLLOVERRIDES"] += ";d3d12=b;d3d12_d3dmetal=b"
            for fixes in GAME_FIXES.values():
                env.update(fixes)
        if g.get("d3dmetal_identity", cfg.get("d3dmetal_identity", "apple")) == "apple":
            gpu = registered_gpu()
            if gpu:
                env["D3DM_VENDOR_ID"] = "0x%04x" % gpu[0]
                env["D3DM_DEVICE_ID"] = "0x%04x" % gpu[1]
                env["D3DM_DEVICE_DESCRIPTION"] = gpu[2]
    if overlays:
        env["WINEDLLPATH_PREPEND"] = ":".join(overlays)
    if renderer in ("dxmt", "d3dmetal"):
        env.update(dxmt_env(cfg, game))
    env["LAYOVER_RENDERER"] = renderer
    for k, v in (g.get("env") or {}).items():
        env[k] = str(v)
    if extra:
        env.update(extra)
    return env


def wine(cfg, args, game=None, wait=True, log=None, extra_env=None, cwd=None):
    env = wine_env(cfg, game, extra_env)
    out = open(log, "ab") if log else subprocess.DEVNULL
    p = subprocess.Popen([WINE] + args, env=env, stdout=out, stderr=subprocess.STDOUT,
                         cwd=cwd, start_new_session=not wait)
    if wait:
        p.wait()
        return p.returncode
    return p


def wineserver_wait(cfg):
    subprocess.run([WINESERVER, "-w"], env=wine_env(cfg), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def close_games(cfg, wait=20):
    """Ask running games to close (WM_CLOSE, like clicking the window's close button) and wait a little.
    A game that is killed instead leaves Steam's "cloud sync failed" prompt for the next launch."""
    exes = running_game_exes()
    if not exes:
        return
    for exe in exes:
        wine(cfg, ["taskkill", "/IM", exe])
    for _ in range(wait):
        if not running_game_exes():
            return
        time.sleep(1)


def is_game_process(cmdline):
    """True for a Mac process line that is a game exe from a Steam library running in our prefix. Wine shows
    the Windows command line, so the path has backslashes (steamapps\\common\\...), not slashes; the watchdog
    matched only the slash form until 2026-10-31 and never attached (no stall capture on 10-24 and 10-26)."""
    low = cmdline.lower().replace("\\", "/")
    return "steamapps/common/" in low and ".exe" in low and "crs-" not in low and "gameoverlayui" not in low and "steamwebhelper" not in low


def running_game_exes():
    """Basenames of game executables running in our prefix (from the Mac process list)."""
    out = sh(["ps", "-axo", "command"])
    found = set()
    for line in out.splitlines():
        if is_game_process(line):
            exe = line.split(".exe")[0].rsplit("/", 1)[-1].rsplit("\\", 1)[-1] + ".exe"
            found.add(exe)
    return sorted(found)


def wineserver_kill(cfg):
    close_games(cfg)
    subprocess.run([WINESERVER, "-k"], env=wine_env(cfg), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reg_add(cfg, key, name, value, kind="REG_SZ"):
    return wine(cfg, ["reg", "add", key, "/v", name, "/t", kind, "/d", str(value), "/f"])


def registry_value(key_path, name):
    """Read a string value from the prefix's user.reg without starting Wine (None if absent)."""
    try:
        with open(os.path.join(PREFIX, "user.reg"), errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    # user.reg writes the key with doubled backslashes: [Software\\Wine\\Mac Driver] <timestamp>
    m = re.search(r'^\[' + re.escape(key_path.replace("\\", "\\\\")) + r'\][^\n]*\n(.*?)(?=^\[|\Z)', text, re.M | re.S)
    if not m:
        return None
    v = re.search(r'^"' + re.escape(name) + r'"="([^"]*)"', m.group(1), re.M)
    return v.group(1) if v else None


def apply_retina(cfg, game=None):
    """Make Wine's Mac driver match config `retina` (3456x2234 vs 1728x1117 on this MacBook), or the
    game's own override. Each Wine process reads the key at start."""
    want = "y" if effective_retina(cfg, game) else "n"
    if registry_value(r"Software\Wine\Mac Driver", "RetinaMode") == want:
        return False
    reg_add(cfg, r"HKCU\Software\Wine\Mac Driver", "RetinaMode", want)
    return True


SHIM_ENV_PATH = os.path.join(PREFIX, "drive_c", "windows", "system32", "d3d12shim.env")


def game_fps_cap(cfg, game=None):
    g = cfg["games"].get(str(game), {}) if game else {}
    try:
        return int(g.get("fps_cap", cfg.get("fps_cap", 0)) or 0)
    except (TypeError, ValueError):
        return 0


def game_metalfx(cfg, game=None):
    """MetalFX spatial upscale factor for a DXMT game (0 = off). DXMT keeps the game's backbuffer at the
    size the game asked for and makes the Metal layer `factor` times larger, so with retina off a game
    at 1728x1117 fills the 3456x2234 panel with a MetalFX-upscaled picture at a quarter of the GPU work."""
    g = cfg["games"].get(str(game), {}) if game else {}
    try:
        f = float(g.get("metalfx", 0) or 0)
    except (TypeError, ValueError):
        return 0
    return f if f > 1.0 else 0


def dxmt_env(cfg, game=None):
    """DXMT settings for a launch (the game inherits them from Steam, so Steam is restarted when they
    change; see launch_fingerprint). D3D12 games under D3DMetal get their cap from our d3d12 shim
    (LAYOVER_MAX_FPS in d3d12shim.env, see write_shim_env)."""
    env = {}
    conf = []
    fps = game_fps_cap(cfg, game)
    if fps:
        conf.append(f"d3d11.preferredMaxFrameRate={fps}")   # DXMT's limiter (D3D11 games); D3DMetal has none
    f = game_metalfx(cfg, game)
    if f:
        env["DXMT_METALFX_SPATIAL_SWAPCHAIN"] = "1"
        conf.append(f"d3d11.metalSpatialUpscaleFactor={f:g}")
    if conf:
        env["DXMT_CONFIG"] = ";".join(conf) + ";"
    return env


def effective_retina(cfg, game=None):
    g = cfg["games"].get(str(game), {}) if game else {}
    return bool(g.get("retina", cfg.get("retina")))


def launch_fingerprint(cfg, game=None):
    """What a game's launch needs from the Steam process it is started by: the renderer, Wine's retina
    mode and the environment the game inherits. Steam is restarted when a game's fingerprint differs
    from the one Steam was started with (running.json)."""
    g = cfg["games"].get(str(game), {}) if game else {}
    env = dxmt_env(cfg, game)
    env.update({k: str(v) for k, v in (g.get("env") or {}).items()})
    return {"renderer": resolve_renderer(cfg, game), "retina": effective_retina(cfg, game), "env": env}


def write_shim_env(cfg, game=None):
    """Settings file the d3d12 shim reads in DllMain (KEY=VALUE; only sets variables that are unset).
    Needed because a Steam-launched game inherits Steam's environment, not ours. Rewritten at every
    launch: a fresh log per run (logs/d3d12-<stamp>.log) plus games.<appid>.env from config.json."""
    if not os.path.isdir(os.path.dirname(SHIM_ENV_PATH)):
        return None
    log = new_log("d3d12")
    env = {"LAYOVER_D3D12_LOG": "Z:" + log.replace("/", "\\"), "LAYOVER_SKIN_LOG": "1", "LAYOVER_MAX_FPS": str(game_fps_cap(cfg, game)),
           "LAYOVER_POOL_SHADERS": "Z:" + SM2_SHADER_DIR.replace("/", "\\")}   # the pool fix's rewritten shaders (layover sm2-shaders)
    g = cfg["games"].get(str(game), {}) if game else {}
    for k, v in (g.get("env") or {}).items():   # per-game values replace the defaults (the shim keeps the first value it reads)
        if k.startswith(("LAYOVER_", "D3DM_", "HB_")):
            env[k] = str(v)
    lines = [f"{k}={v}" for k, v in env.items()]
    try:
        with open(SHIM_ENV_PATH, "w") as f:
            f.write("\n".join(lines) + "\n")
    except OSError:
        return None
    return log


def new_log(name):
    os.makedirs(LOGS, exist_ok=True)
    stamp = _dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    path = os.path.join(LOGS, f"{name}-{stamp}.log")
    # keep the 20 most recent logs (any kind: steam-*, d3d12-*, setup-*)
    old = sorted((p for p in os.listdir(LOGS) if p.endswith(".log")), key=lambda p: os.path.getmtime(os.path.join(LOGS, p)))
    for p in old[:-20]:
        try:
            os.remove(os.path.join(LOGS, p))
        except OSError:
            pass
    return path


# --------------------------------------------------------------------------- engine assembly
def renderer_installed(renderer):
    if renderer == "auto":
        return renderer_installed("dxmt") and renderer_installed("d3dmetal")
    if renderer == "wined3d":
        return engine_ready()
    if renderer == "dxmt":
        return os.path.isfile(os.path.join(ENGINE_RENDERERS, "dxmt", "wine", "x86_64-windows", "d3d11.dll"))
    if renderer == "d3dmetal":
        return os.path.isfile(os.path.join(ENGINE_RENDERERS, "d3dmetal", "wine", "x86_64-windows", "d3d12.dll")) and \
            os.path.isdir(os.path.join(ENGINE_RENDERERS, "d3dmetal", "external", "D3DMetal.framework"))
    return False


def _same_content(a, b):
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        return sha256(a) == sha256(b)
    except OSError:
        return False


def replace_file(src, dst):
    """Copy src over dst atomically (temp file + rename). A game that has the old dst mapped keeps
    running on the old inode instead of seeing its code change under it."""
    tmp = dst + ".new"
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def _same_file(a, b):
    try:
        with open(a, "rb") as fa, open(b, "rb") as fb:
            return fa.read(1 << 16) == fb.read(1 << 16)
    except OSError:
        return False


def assemble_engine():
    """Download (cached) and lay out the engine the way Highball's installer does:
         engines/<id>/engine/        Wine (bin, lib, share)  [+ patched wineserver, ntdll.so, winemac.so]
         engines/<id>/frameworks/    runtime dylibs, GStreamer, MoltenVK, audiobuf
         engines/<id>/renderers/     dxmt/wine, d3dmetal/{wine,external}
    """
    paths = {}
    for key, comp in COMPONENTS.items():
        paths[key] = download(comp["url"], os.path.join(CACHE, os.path.basename(comp["url"])), comp["sha256"], comp["label"])
    staging = ENGINE_DIR + ".partial"
    shutil.rmtree(staging, ignore_errors=True)
    os.makedirs(os.path.join(staging, "renderers"), exist_ok=True)
    info("unpacking the engine (about a minute)")
    for key in COMPONENTS:
        extract(paths[key], os.path.join(staging, ".x-" + key))
    x = lambda key, *rest: os.path.join(staging, ".x-" + key, *rest)
    # Wine (Sikarugir engine tarballs wrap it in wswine.bundle/)
    shutil.move(x("wine", "wswine.bundle"), os.path.join(staging, "engine"))
    # runtime frameworks (+ D3DMetal) from the Sikarugir template
    tpl = next(d for d in os.listdir(x("runtime")) if d.endswith(".app"))
    shutil.move(x("runtime", tpl, "Contents", "Frameworks"), os.path.join(staging, "frameworks"))
    d3dm = os.path.join(staging, "frameworks", "renderer", "d3dmetal")
    if os.path.isdir(d3dm):
        shutil.move(d3dm, os.path.join(staging, "renderers", "d3dmetal"))
    shutil.rmtree(os.path.join(staging, "frameworks", "renderer"), ignore_errors=True)
    i386 = os.path.join(staging, "renderers", "d3dmetal", "wine", "i386-windows")
    if os.path.islink(i386):
        os.remove(i386)   # pointed at a sibling renderer we dropped; 32-bit D3DMetal is not a thing anyway
    # DXMT (Highball fork)
    os.makedirs(os.path.join(staging, "renderers", "dxmt"), exist_ok=True)
    shutil.move(x("dxmt", "highball"), os.path.join(staging, "renderers", "dxmt", "wine"))
    # patched MoltenVK, audio buffer library, msync fix, Mac driver fix
    shutil.copy2(x("moltenvk", "libMoltenVK.dylib"), os.path.join(staging, "frameworks", "libMoltenVK.dylib"))
    shutil.copy2(x("audiobuf", "libhbaudiobuf.dylib"), os.path.join(staging, "frameworks", "libhbaudiobuf.dylib"))
    shutil.copy2(x("msync", "wineserver"), os.path.join(staging, "engine", "bin", "wineserver"))
    shutil.copy2(x("msync", "ntdll.so"), os.path.join(staging, "engine", "lib", "wine", "x86_64-unix", "ntdll.so"))
    shutil.copy2(x("winemac", "winemac.so"), os.path.join(staging, "engine", "lib", "wine", "x86_64-unix", "winemac.so"))
    os.chmod(os.path.join(staging, "engine", "bin", "wineserver"), 0o755)
    # link runtime dylibs into engine/lib like Highball does (belt and braces next to DYLD fallback)
    lib = os.path.join(staging, "engine", "lib")
    for base in (os.path.join(staging, "frameworks"), os.path.join(staging, "frameworks", "GStreamer.framework", "Versions", "1.0", "lib")):
        if not os.path.isdir(base):
            continue
        rel = os.path.relpath(base, lib)
        for name in os.listdir(base):
            if name.endswith(".dylib") and not os.path.lexists(os.path.join(lib, name)):
                os.symlink(os.path.join(rel, name), os.path.join(lib, name))
    for key in COMPONENTS:
        shutil.rmtree(x(key), ignore_errors=True)
    shutil.rmtree(ENGINE_DIR, ignore_errors=True)
    os.rename(staging, ENGINE_DIR)
    run(["xattr", "-dr", "com.apple.quarantine", ENGINE_DIR])
    with open(os.path.join(ENGINE_DIR, "manifest.json"), "w") as f:
        json.dump({"id": ENGINE_ID, "components": COMPONENTS, "assembled": _dt.datetime.now().isoformat()}, f, indent=2)


# --------------------------------------------------------------------------- steam web-helper wrapper
# Steam's UI is a Chromium (CEF) process. Under Wine on Apple Silicon its renderer paints
# the window black and its network service trips over winsock. Forcing CEF into
# "--disable-gpu --single-process" fixes both (finding from notpop/steam-on-m1-wine, MIT).
# Steam ignores its own -cef-single-process flag nowadays, so we rename Valve's
# steamwebhelper.exe to steamwebhelper_real.exe and drop in a tiny wrapper that adds the
# flags and execs the real one. Steam's startup verification would restore the original,
# hence the -noverifyfiles family of flags in steam_args.
WRAPPER_SRC_DIR = os.path.join(HERE, "wrapper")
WRAPPER_EXE = os.path.join(WRAPPER_SRC_DIR, "steamwebhelper.exe")
WRAPPER_MAX_SIZE = 500_000   # Valve's helper is ~7 MB; ours is ~150 KB
MINGW_GCC = "/opt/homebrew/bin/x86_64-w64-mingw32-gcc"


WRAPPER_INSTALLED = os.path.join(TOOLS, "steamwebhelper.exe")

# AMD AGS replacement. D3DMetal presents itself as an AMD GPU, so games that bundle AMD's
# AGS runtime (amd_ags_x64.dll) initialise it; the real one needs AMD's ADL driver library and
# fails under Wine, which Spider-Man 2 reports as "No installed graphics card has been
# detected". Our build answers from DXGI and creates DX12 devices with plain D3D12CreateDevice.
# It is marked as a Wine builtin and selected with WINEDLLOVERRIDES amd_ags_x64=b when D3DMetal
# is the renderer (see shims/amd_ags).
AGS_SHIM_SRC_DIR = os.path.join(HERE, "shims", "amd_ags")
AGS_SHIM_DLL = os.path.join(AGS_SHIM_SRC_DIR, "amd_ags_x64.dll")
AGS_SHIM_INSTALLED = os.path.join(TOOLS, "amd_ags_x64.dll")
MINGW_GXX = "/opt/homebrew/bin/x86_64-w64-mingw32-g++"


def ags_shim_binary():
    """Path to the AGS replacement DLL, kept under Application Support like the wrapper."""
    os.makedirs(TOOLS, exist_ok=True)
    try:
        if not os.path.exists(AGS_SHIM_DLL) and os.path.exists(MINGW_GXX) and os.path.isdir(AGS_SHIM_SRC_DIR):
            subprocess.run(["make", "-s", "-C", AGS_SHIM_SRC_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(AGS_SHIM_DLL) and os.path.getsize(AGS_SHIM_DLL) > 0:
            if not os.path.exists(AGS_SHIM_INSTALLED) or os.path.getsize(AGS_SHIM_INSTALLED) != os.path.getsize(AGS_SHIM_DLL):
                shutil.copy2(AGS_SHIM_DLL, AGS_SHIM_INSTALLED)
    except PermissionError:
        pass   # Documents not readable from this session; use whatever copy exists
    return AGS_SHIM_INSTALLED if os.path.exists(AGS_SHIM_INSTALLED) else None


# d3d12shim: our d3d12.dll in front of D3DMetal's (shims/d3d12shim). It carries per-game fixes and an
# optional D3D12 call trace. Laid out like Highball's tsshim: an overlay dir listed FIRST in
# WINEDLLPATH_PREPEND holding d3d12.dll (ours) and d3d12_d3dmetal.dll (D3DMetal's, renamed; Wine
# resolves builtins by base name), x86_64-unix/d3d12_d3dmetal.so -> libd3dshared.dylib, a system32
# placeholder of that name in the prefix, and WINEDLLOVERRIDES d3d12=b;d3d12_d3dmetal=b.
D3D12_SHIM_SRC_DIR = os.path.join(HERE, "shims", "d3d12shim")
D3D12_SHIM_DLL = os.path.join(D3D12_SHIM_SRC_DIR, "d3d12.dll")
D3D12_SHIM_INSTALLED = os.path.join(TOOLS, "d3d12shim.dll")
D3D12_SHIM_OVERLAY = os.path.join(ENGINE_RENDERERS, "d3d12shim", "wine")
MINGW_GCC = "/opt/homebrew/bin/x86_64-w64-mingw32-gcc"
# Per-game environment applied whenever D3DMetal is the renderer (the shim checks the exe name itself).
# 2651280 Marvel's Spider-Man 2: its 2046 MB "ManagedBuffer" pool is viewed through typed buffers of
# more than 2^28 elements, which Metal cannot do; D3DMetal clamps them and every character whose data
# lands above the clamp stays in its bind pose (T-pose). The shim shrinks the pool to 1022 MB.
# Status 2026-10-08 evening: the shim now fixes this by itself (sm2_skin.c, on by default for
# Spider-Man2.exe): skinned models' GPU blobs are moved into a subheap in the first 1 GB of the pool.
# Nothing to set here; knobs LAYOVER_SKIN_MB / LAYOVER_IMPOSTOR_MB / LAYOVER_PLUG / LAYOVER_SKIN_LOG
# can go into games.2651280.env in config.json or the prefix's windows/system32/d3d12shim.env.
# (LAYOVER_MANAGED_MB=1022 was the earlier experiment: animates, but the city overflows 1 GB.)
GAME_FIXES = {}


def d3d12_shim_binary():
    os.makedirs(TOOLS, exist_ok=True)
    try:
        if os.path.exists(MINGW_GCC) and os.path.isdir(D3D12_SHIM_SRC_DIR):
            # make is a no-op when d3d12.dll is newer than its sources
            subprocess.run(["make", "-s", "-C", D3D12_SHIM_SRC_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(D3D12_SHIM_DLL) and os.path.getsize(D3D12_SHIM_DLL) > 0 and not _same_content(D3D12_SHIM_DLL, D3D12_SHIM_INSTALLED):
            replace_file(D3D12_SHIM_DLL, D3D12_SHIM_INSTALLED)
    except PermissionError:
        pass
    return D3D12_SHIM_INSTALLED if os.path.exists(D3D12_SHIM_INSTALLED) else None


def d3d12_shim_installed():
    w = os.path.join(D3D12_SHIM_OVERLAY, "x86_64-windows")
    return os.path.isfile(os.path.join(w, "d3d12.dll")) and os.path.isfile(os.path.join(w, "d3d12_d3dmetal.dll")) and \
        os.path.islink(os.path.join(D3D12_SHIM_OVERLAY, "x86_64-unix", "d3d12_d3dmetal.so"))


def install_d3d12_shim(quiet=True):
    """Lay the d3d12 shim overlay out next to the D3DMetal renderer. Safe to call before every launch."""
    real = os.path.join(ENGINE_RENDERERS, "d3dmetal", "wine", "x86_64-windows", "d3d12.dll")
    dylib = os.path.join(ENGINE_RENDERERS, "d3dmetal", "external", "libd3dshared.dylib")
    if not (os.path.isfile(real) and os.path.isfile(dylib)):
        return False
    src = d3d12_shim_binary()
    if not src:
        if not quiet:
            warn("d3d12 shim not available (needs mingw-w64 to build); Spider-Man 2 characters will T-pose")
        return False
    w = os.path.join(D3D12_SHIM_OVERLAY, "x86_64-windows"); u = os.path.join(D3D12_SHIM_OVERLAY, "x86_64-unix")
    os.makedirs(w, exist_ok=True); os.makedirs(u, exist_ok=True)
    for dst, from_ in ((os.path.join(w, "d3d12.dll"), src), (os.path.join(w, "d3d12_d3dmetal.dll"), real)):
        if not _same_content(from_, dst):
            replace_file(from_, dst)
    so = os.path.join(u, "d3d12_d3dmetal.so")
    if not os.path.islink(so):
        if os.path.exists(so):
            os.remove(so)
        os.symlink(os.path.relpath(dylib, u), so)
    placeholder = os.path.join(PREFIX, "drive_c", "windows", "system32", "d3d12_d3dmetal.dll")
    stock = os.path.join(PREFIX, "drive_c", "windows", "system32", "d3d12.dll")
    if not os.path.isfile(placeholder) and os.path.isfile(stock):
        shutil.copy2(stock, placeholder)   # Wine only finds a builtin that has a system32 placeholder
    if not quiet:
        ok("d3d12 shim in place (in front of D3DMetal: Spider-Man 2 T-pose fix)")
    return True


def ags_shim_overlay_path():
    return os.path.join(ENGINE_RENDERERS, "d3dmetal", "wine", "x86_64-windows", "amd_ags_x64.dll")


def install_ags_shim(quiet=True):
    """Put the AGS replacement into the D3DMetal overlay. Safe to call before every launch."""
    target = ags_shim_overlay_path()
    if not os.path.isdir(os.path.dirname(target)):
        return False
    src = ags_shim_binary()
    if not src:
        if not quiet:
            warn("AGS replacement DLL not available; DX12 games that bundle AMD AGS may complain about the graphics card")
        return False
    if not os.path.isfile(target) or os.path.getsize(target) != os.path.getsize(src):
        shutil.copy2(src, target)
    if not quiet:
        ok("AMD AGS replacement in place (D3DMetal overlay)")
    return True


def wrapper_binary():
    """Path to the compiled wrapper. A copy is kept under Application Support because macOS
    may refuse Terminal access to files in Documents (Files & Folders privacy); builds it with
    mingw-w64 if no prebuilt copy exists."""
    os.makedirs(TOOLS, exist_ok=True)
    try:
        if os.path.exists(WRAPPER_EXE) and 0 < os.path.getsize(WRAPPER_EXE) < WRAPPER_MAX_SIZE:
            if not os.path.exists(WRAPPER_INSTALLED) or os.path.getsize(WRAPPER_INSTALLED) != os.path.getsize(WRAPPER_EXE):
                shutil.copy2(WRAPPER_EXE, WRAPPER_INSTALLED)
    except PermissionError:
        if not os.path.exists(WRAPPER_INSTALLED):
            warn("macOS blocked reading the wrapper from the Documents folder.")
            warn("Allow Terminal in System Settings → Privacy & Security → Files and Folders → Documents, or run `layover setup` once from the original session.")
    if os.path.exists(WRAPPER_INSTALLED):
        return WRAPPER_INSTALLED
    src = os.path.join(WRAPPER_SRC_DIR, "src", "steamwebhelper-wrapper.c")
    if not os.path.exists(src):
        return None
    if not os.path.exists(MINGW_GCC):
        info("installing the mingw-w64 cross compiler to build the Steam web-helper wrapper (one time, ~1.5 GB)")
        subprocess.run(["brew", "install", "mingw-w64"])
    if not os.path.exists(MINGW_GCC):
        return None
    r = run([MINGW_GCC, "-O2", "-municode", "-DUNICODE", "-D_UNICODE", "-o", WRAPPER_INSTALLED, src,
             "-static", "-lshell32", "-mwindows"])
    if r.returncode != 0:
        warn("wrapper build failed: " + r.stderr[-400:])
        return None
    return WRAPPER_INSTALLED


def install_webhelper_wrapper(quiet=True):
    """Make sure every cef.win* dir has: steamwebhelper.exe = our wrapper, steamwebhelper_real.exe = Valve's.
    Safe to call before every launch; it heals whatever state Steam's updater left behind."""
    cef_root = os.path.join(STEAM_DIR, "bin", "cef")
    if not os.path.isdir(cef_root):
        return False
    wrapper = wrapper_binary()
    if not wrapper:
        warn("no web-helper wrapper available; Steam's window may be black")
        return False
    done = False
    for d in os.listdir(cef_root):
        cef = os.path.join(cef_root, d)
        target = os.path.join(cef, "steamwebhelper.exe")
        real = os.path.join(cef, "steamwebhelper_real.exe")
        if not os.path.isfile(target):
            continue
        target_is_valve = os.path.getsize(target) > WRAPPER_MAX_SIZE
        real_is_valve = os.path.isfile(real) and os.path.getsize(real) > WRAPPER_MAX_SIZE
        if target_is_valve:
            # Steam restored/updated its helper: keep the newest Valve copy as _real.
            shutil.move(target, real)
            real_is_valve = True
        if not real_is_valve:
            warn(f"{d}: Valve's steamwebhelper is missing; run `layover update-steam` to restore it")
            continue
        if not os.path.isfile(target) or not _same_file(wrapper, target) or os.path.getsize(target) != os.path.getsize(wrapper):
            shutil.copy2(wrapper, target)
        done = True
    if done and not quiet:
        ok("Steam web-helper wrapper in place")
    return done


def remove_webhelper_wrapper():
    cef_root = os.path.join(STEAM_DIR, "bin", "cef")
    if not os.path.isdir(cef_root):
        return
    for d in os.listdir(cef_root):
        cef = os.path.join(cef_root, d)
        target = os.path.join(cef, "steamwebhelper.exe")
        real = os.path.join(cef, "steamwebhelper_real.exe")
        if os.path.isfile(real) and os.path.getsize(real) > WRAPPER_MAX_SIZE:
            shutil.move(real, target)


