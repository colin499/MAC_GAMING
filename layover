        ("Controller check", lambda: cmd_controller(argparse.Namespace(test=False, seconds=15, open_settings=False))),
        ("Controller input test (15 s)", lambda: cmd_controller(argparse.Namespace(test=True, seconds=15, open_settings=False))),
        ("Pre-flight checklist", lambda: cmd_flight(argparse.Namespace(go=False, set_offline=False, online=False))),
        ("Pre-flight + set offline + launch", lambda: cmd_flight(argparse.Namespace(go=True, set_offline=True, online=False))),
        ("Back online (after the flight)", lambda: cmd_flight(argparse.Namespace(go=False, set_offline=False, online=True))),
        ("Doctor (health check)", lambda: cmd_doctor(None)),
        ("Setup / repair", lambda: cmd_setup(argparse.Namespace(reinstall=False, d3dmetal=False, no_launch=True))),
        ("Stop Steam", lambda: cmd_kill(None)),
    ]
    while True:
        head(f"✈  {APP_NAME}")
        for i, (label, _) in enumerate(items, 1):
            print(f"  {i:>2}. {label}")
        print("   q. quit")
        try:
            choice = input("\n  > ").strip().lower()
        except EOFError:
            return
        if choice in ("q", "quit", "exit", ""):
            return
        if choice.isdigit() and 1 <= int(choice) <= len(items):
            try:
                items[int(choice) - 1][1]()
            except SystemExit:
                pass
            except KeyboardInterrupt:
                print()
        else:
            warn("pick a number")


