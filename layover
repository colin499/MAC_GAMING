    s.add_argument("game", help="game name/AppID (installed or just owned)")
    s.add_argument("key", nargs="?")
    s.add_argument("value", nargs="?", help="'default' removes the override; env takes KEY=VALUE pairs (KEY= removes)")
    s.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=lambda a: cmd_game(a) if (a.key is None or a.value is not None) else die("usage: layover game <game> [<key> <value>]"))

    s = sub.add_parser("config", help="show or change a setting (msync, metal_hud, advertise_avx, retina, steam_overlay, fps_cap, steam_args, d3dmetal_identity)")
    s.add_argument("key", nargs="?")
    s.add_argument("value", nargs="?", help="for steam_args, quote the whole list, e.g. \"-cef-disable-gpu -noverifyfiles\"")
    s.set_defaults(fn=lambda a: cmd_config(a) if (a.key is None or a.value is not None) else die("usage: layover config <key> <value>"))

    s = sub.add_parser("watch", help=argparse.SUPPRESS)   # started by `play`: display awake, health log, stall capture
    s.add_argument("game")
    s.add_argument("--name")
    s.add_argument("--wait", type=int, default=240, help="seconds to wait for the game process")
    s.add_argument("--stall-fps", type=float, default=8.0)
    s.set_defaults(fn=cmd_watch)
    sub.add_parser("doctor", help="health check").set_defaults(fn=cmd_doctor)
    s = sub.add_parser("sm2-shaders", help="build Spider-Man 2's pool-fix shaders (symbiote glitch + T-pose at the root; needs tools/dev/build-dxc.sh once)")
    s.add_argument("--status", action="store_true", help="only show which shaders are built")
    s.add_argument("--force", action="store_true", help="rebuild even if present")
    s.set_defaults(fn=cmd_sm2_shaders)
    sub.add_parser("kill", help="stop Steam and the Windows prefix").set_defaults(fn=cmd_kill)
    sub.add_parser("quit", help="same as kill: fully quit Steam (closing its window only hides it)").set_defaults(fn=cmd_kill)
    sub.add_parser("logs", help="show the latest launch log").set_defaults(fn=cmd_logs)
    sub.add_parser("winecfg", help="open Wine's settings window for the prefix").set_defaults(fn=cmd_winecfg)
    s = sub.add_parser("uninstall", help="remove Layover and everything it installed")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(fn=cmd_uninstall)
    s = sub.add_parser("app", help="build ~/Applications/Layover.app: the library window (double-click, no Terminal)")
    s.add_argument("--snapshot", help="render the window to a PNG without showing it (for checking the UI headless)")
    s.set_defaults(fn=cmd_app)
    sub.add_parser("app-launch", help=argparse.SUPPRESS).set_defaults(fn=cmd_app_launch)
    sub.add_parser("menu", help="interactive menu").set_defaults(fn=cmd_menu)
    sub.add_parser("help", help="show help").set_defaults(fn=lambda a: p.print_help())

    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) >= 3 and argv[0] == "config" and argv[2].startswith("-"):
        argv.insert(2, "--")   # let values like "-cef-disable-gpu" through argparse
    args = p.parse_args(argv)
    global JSON_MODE
    JSON_MODE = bool(getattr(args, "json", False))
    if not args.cmd:
        cmd_menu(args) if tty() else p.print_help()
        return
    try:
        args.fn(args)
    except KeyboardInterrupt:
        print()
        sys.exit(130)
    except Exception as e:   # an unexpected failure still yields one JSON document for the app
        if not JSON_MODE:
            raise
        print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}", "code": 1}))
        sys.exit(1)


if __name__ == "__main__":
    main()
