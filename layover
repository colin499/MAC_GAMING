            if g["ready"]:
                ok(f"{g['name']} ({'Windows' if g['where']=='windows' else 'Mac'}) installed")
            else:
                warn(f"{g['name']} needs an update/validation — launch it once while online")
                problems += 1
    else:
        bad("no games installed")
        problems += 1
    info("tip: launch each game once while online so Steam caches its config and shader data")

    pads = xbox_controllers()
    if pads:
        for p in pads:
            lvl = p["battery"]
            ok(f"controller {p['name']} ({p['link']}){', battery ' + str(lvl) if lvl else ''}")
            if lvl and str(lvl).rstrip('%').isdigit() and int(str(lvl).rstrip('%')) < 40:
                warn("controller battery is low — charge it or bring a USB-C cable")
    else:
        warn("no controller connected now — pair/plug it before boarding (layover controller)")
        if paired_but_disconnected():
            info("it is already paired; press the Xbox button to reconnect")

    pct, state = battery()
    if pct is not None:
        (ok if pct >= 80 else warn)(f"MacBook battery {pct}% ({state})")
    fd = free_disk()
    (ok if fd > 10 << 30 else warn)(f"free disk {human(fd)}")

    # Offline mode
    if args.online:
        for where in ("windows", "mac"):
            if set_offline_mode(where, False):
                ok(f"{where} Steam set back to online mode")
        return
    if steam_running() or native_steam_running():
        if args.go or args.set_offline:
            info("closing Steam to switch it to offline mode")
            if steam_running():
                wineserver_kill(cfg)
            if native_steam_running():
                subprocess.run(["osascript", "-e", 'tell application "Steam" to quit'], capture_output=True)
            for _ in range(30):
                if not steam_running() and not native_steam_running():
                    break
                time.sleep(1)
        else:
            warn("Steam is running. Use its menu Steam → Go Offline, or run: layover flight --set-offline")
    if args.go or args.set_offline:
        if set_offline_mode("windows", True):
            ok("Windows Steam will start in OFFLINE mode")
        if set_offline_mode("mac", True):
            ok("Mac Steam will start in OFFLINE mode")
        info("to go back online later: layover flight --online  (or Steam menu → Go Online)")
    else:
        info("to switch Steam to offline mode now: layover flight --set-offline")

    print()
    if problems:
        warn(f"{problems} thing(s) to fix while you still have Wi-Fi")
    else:
        ok(paint("Cleared for takeoff.", C.B))
    if args.go:
        if problems:
            warn("launching anyway")
        log = launch_steam(cfg, offline=True)
        ok(f"Steam starting offline; log: {log}")
    print()


def cmd_renderer(args):
    cfg = load_config()
    if args.game is None:
        for r in RENDERER_CHOICES:
            info(f"{r:<9} {RENDERER_HELP[r]}")
        info(f"default renderer: {cfg['renderer']}")
        for appid, g in cfg["games"].items():
            if "renderer" in g:
                info(f"  {appid}: {g['renderer']}")
        return
    if args.game == "default":
        cfg["renderer"] = args.renderer
        save_config(cfg)
        ok(f"default renderer → {args.renderer}")
        return
    g = find_game(args.game, all_games())
    if not g:
        die(f"no installed game matches '{args.game}'")
    cfg["games"].setdefault(g["appid"], {})["renderer"] = args.renderer
    save_config(cfg)
    ok(f"{g['name']} → {args.renderer}  (applies next time Steam is launched)")


def cmd_config(args):
    cfg = load_config()
    if args.key is None:
        print(json.dumps({k: v for k, v in cfg.items() if k != "games"}, indent=2))
        return
    if args.key not in DEFAULT_CONFIG or args.key == "games":
        die(f"unknown setting '{args.key}'. Settings: " + ", ".join(k for k in DEFAULT_CONFIG if k != 'games'))
    val = args.value
    if isinstance(DEFAULT_CONFIG[args.key], bool):
        val = val.lower() in ("1", "true", "on", "yes", "y")
    elif isinstance(DEFAULT_CONFIG[args.key], list):
        val = val.split()
    elif isinstance(DEFAULT_CONFIG[args.key], int):
        try:
            val = int(val)
        except ValueError:
            die(f"{args.key} needs a whole number (0 = off)")
    elif args.key == "d3dmetal_identity" and val not in D3DMETAL_IDENTITIES:
        die("d3dmetal_identity must be one of: " + ", ".join(D3DMETAL_IDENTITIES))
    cfg[args.key] = val
    save_config(cfg)
    ok(f"{args.key} = {val}")
    if args.key == "fps_cap":
        info("applies when a game is next launched (D3D12 games: the d3d12 shim paces frames; D3D11 games: DXMT, needs a Steam restart)" if val else "frame rate uncapped from the next game launch")
    if args.key == "retina" and engine_ready() and os.path.isdir(os.path.join(PREFIX, "drive_c")):
        apply_retina(cfg)
        if val:
            info("games now see the full 3456x2234 panel. In the game's display settings pick that")
            info("resolution (fullscreen or a maximized window) and an upscaler (FSR Balanced/Performance)")
            info("so it renders around 1728x1117 internally and only the output is native-sharp.")
        else:
            info("games see 1728x1117 again; re-pick the resolution in the game's display settings.")


def cmd_kill(args):
