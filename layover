# --------------------------------------------------------------------------- game watchdog
# `layover play` starts a detached `layover watch <appid>` next to every game. It (1) keeps the display
# awake while the game runs (Wine games never tell macOS they are busy, so a long cinematic with no
# input lets the screen sleep after 5 min on battery), (2) writes a health line every minute (fps from
# the shim log, the game's memory, the host's free memory, battery, CPU throttle) to logs/watch-*.log,
# and (3) when the shim's fps collapses (< 8 fps after the game ran at 20+) it saves a `sample` of the
# game plus memory/thermal state to logs/stall-*.txt and posts a notification. 2026-10-24: Spider-Man 2
# went from 60 fps to 2 fps in one second during a cinematic with nothing in any log; next time there
# will be a stack sample of the moment. It exits with the game.
WATCH_PID = os.path.join(ROOT, "watch.pid")


def game_host_pid():
    """Host pid of the game exe running in our prefix (the Wine process for steamapps/common/...exe)."""
    out = sh(["ps", "-axo", "pid=,command="])
    for line in out.splitlines():
        if is_game_process(line):
            try:
                return int(line.split(None, 1)[0])
            except ValueError:
                pass
    return None


def metal_compiler_cpu():
    """CPU % of Apple's Metal shader compiler services right now (MTLCompilerService processes). High while
    the game runs = shaders being compiled (a stall with this high is a compile storm, not the GPU)."""
    out = sh(["ps", "-axo", "pcpu=,comm="])
    total = 0.0
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and "MTLCompilerService" in parts[1]:
            try:
                total += float(parts[0])
            except ValueError:
                pass
    return total


def shim_log_path():
    try:
        with open(SHIM_ENV_PATH) as f:
            for line in f:
                if line.startswith("LAYOVER_D3D12_LOG="):
                    return line.split("=", 1)[1].strip()[2:].replace("\\", "/")
    except OSError:
        pass
    return None


def shim_presents(path):
    """(presents, timestamp) from the last `stats:` line of a shim log, or None."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 65536))
            tail = f.read().decode(errors="replace")
    except OSError:
        return None
    m = None
    for m in re.finditer(r"^(\d\d:\d\d:\d\d)\.\d+ \[\d+\] stats: presents=(\d+)", tail, re.M):
        pass
    return (int(m.group(2)), m.group(1)) if m else None


def host_memory():
    """(free MB, used-by-apps MB) from vm_stat; free counts inactive and speculative pages too."""
    out = sh(["vm_stat"])
    pages = {k.strip(): int(v.strip(" .")) for k, v in (l.split(":", 1) for l in out.splitlines() if ":" in l and l.split(":", 1)[1].strip(" .").isdigit())}
    pg = 16384
    free = (pages.get("Pages free", 0) + pages.get("Pages inactive", 0) + pages.get("Pages speculative", 0) + pages.get("Pages purgeable", 0)) * pg
    used = (pages.get("Pages active", 0) + pages.get("Pages wired down", 0) + pages.get("Pages occupied by compressor", 0)) * pg
    return free >> 20, used >> 20


def cpu_throttle():
    """CPU speed limit in % from pmset (100 = no throttling), or None when macOS has nothing recorded."""
    out = sh(["pmset", "-g", "therm"])
    m = re.search(r"CPU_Speed_Limit\s*=\s*(\d+)", out)
    return int(m.group(1)) if m else None


def process_rss_mb(pid):
    out = sh(["ps", "-o", "rss=", "-p", str(pid)])
    return int(out) // 1024 if out.strip().isdigit() else 0


def big_apps(min_mb=400, limit=8):
    """[(MB, name)] of the biggest user processes, one entry per app, over min_mb."""
    out = sh(["ps", "-axo", "rss=,comm="])
    apps = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2 or not parts[0].isdigit():
            continue
        mb = int(parts[0]) // 1024
        cmd = parts[1]
        if "/Applications/" in cmd or "/Library/" in cmd:
            m = re.search(r"/([^/]+)\.app/", cmd)
            name = m.group(1) if m else os.path.basename(cmd)
        else:
            name = os.path.basename(cmd)
        if name.lower() in ("kernel_task", "windowserver", "python3", "wine", "wine64-preloader", "wineserver", "caffeinate") or name.startswith("Layover"):
            continue
        apps[name] = apps.get(name, 0) + mb
    return sorted(((mb, n) for n, mb in apps.items() if mb >= min_mb), reverse=True)[:limit]


def stall_capture(pid, name, fps, reason):
    os.makedirs(LOGS, exist_ok=True)
    stamp = _dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    path = os.path.join(LOGS, f"stall-{stamp}.txt")
    free, used = host_memory()
    pct, state = battery()
    parts = [f"Layover stall capture {stamp}: {name} (pid {pid}) at {fps:.1f} fps; {reason}",
             f"host memory: {free} MB free, {used} MB in use; game RSS {process_rss_mb(pid)} MB; battery {pct}% ({state}); CPU speed limit {cpu_throttle()}",
             f"Metal shader compiler (MTLCompilerService) CPU: {metal_compiler_cpu():.0f}%  (high = shaders compiling, not a GPU stall)",
             "", "== pmset -g therm", sh(["pmset", "-g", "therm"]), "", "== memory_pressure", sh(["memory_pressure"])[-800:],
             "", "== top (cpu)", sh(["top", "-l", "1", "-o", "cpu", "-n", "15", "-stats", "pid,cpu,mem,command"])[-2500:],
             "", "== sample of the game (3 s)"]
    r = run(["sample", str(pid), "3", "-mayDie"], timeout=60)
    parts.append(r.stdout if r.returncode == 0 else f"sample failed ({r.returncode}): {r.stderr.strip()[:300]}")
    with open(path, "w") as f:
        f.write("\n".join(parts) + "\n")
    old = sorted(glob.glob(os.path.join(LOGS, "stall-*.txt")), key=os.path.getmtime)
    for p in old[:-10]:
        try:
            os.remove(p)
        except OSError:
            pass
    return path


def spawn_watch(appid, name):
    """Start the detached watchdog for a game launch (one per game; an older one is told to quit)."""
    try:
        with open(WATCH_PID) as f:
            old = int(f.read().strip() or 0)
        if old and old != os.getpid():
            os.kill(old, 15)
    except (OSError, ValueError):
        pass
    try:
        os.makedirs(LOGS, exist_ok=True)
        log = open(os.path.join(LOGS, "watch.log"), "ab")
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch", str(appid), "--name", name],
                         stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        warn(f"could not start the game watchdog: {e}")


def cmd_watch(args):
    name = args.name or str(args.game)
    try:
        with open(WATCH_PID, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    log_path = os.path.join(LOGS, "watch.log")
    try:
        if os.path.getsize(log_path) > (1 << 20):
            open(log_path, "w").close()
    except OSError:
        pass

    def w(msg):
        print(_dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)

    w(f"watch: waiting for {name} to start")
    pid = None
    for _ in range(args.wait):
        pid = game_host_pid()
        if pid:
            break
        time.sleep(1)
    if not pid:
        w("watch: the game did not start within the wait; giving up")
        try:
            os.remove(WATCH_PID)
        except OSError:
            pass
        return
    shim = shim_log_path()
    w(f"watch: {name} is pid {pid}; shim log {shim or 'none'}")
    try:
        caf = subprocess.Popen(["caffeinate", "-d", "-i", "-w", str(pid)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        w("watch: display kept awake while the game runs (caffeinate)")
    except OSError:
        caf = None
    last = None
    good = 0            # consecutive 5 s windows at 20+ fps
    stalled = False
    captures = 0
    minute = 0
    fps = 0.0
    while True:
        time.sleep(5)
        try:
            os.kill(pid, 0)
        except OSError:
            break
        cur = shim_presents(shim) if shim else None
        if cur and last and cur[1] != last[1]:
            fps = (cur[0] - last[0]) / 5.0
            if fps >= 20:
                good = min(good + 1, 6)
                if stalled:
                    w(f"recovered: {fps:.1f} fps")
                    stalled = False
            elif fps < args.stall_fps and good >= 6 and not stalled:
                if fps == 0:   # no presents at all: usually the game shutting down, not a stall; give it a moment
                    time.sleep(3)
                    try:
                        os.kill(pid, 0)
                    except OSError:
                        break
                stalled = True
                reason = f"after {good * 5}+ s above 20 fps"
                w(f"STALL: {fps:.1f} fps {reason}")
                if captures < 3:
                    captures += 1
                    path = stall_capture(pid, name, fps, reason)
                    w(f"saved {path}")
                    notify("Layover", f"{name} dropped to {fps:.0f} fps; diagnostics saved to logs/{os.path.basename(path)}")
        if cur:
            last = cur
        minute += 1
        if minute % 12 == 0:
            free, used = host_memory()
            pct, state = battery()
            thr = cpu_throttle()
            mtl = metal_compiler_cpu()
            w(f"health: {fps:.1f} fps | game {process_rss_mb(pid)} MB | host free {free} MB | battery {pct}% {state or ''}" + (f" | cpu limit {thr}%" if thr not in (None, 100) else "") + (f" | shader compiler {mtl:.0f}%" if mtl >= 5 else ""))
    w(f"watch: {name} exited")
    if caf and caf.poll() is None:
        caf.terminate()
    try:
        os.remove(WATCH_PID)
    except OSError:
        pass


# --------------------------------------------------------------------------- Spider-Man 2 pool-fix shaders
# D3DMetal on M1-M4 backs typed buffer views with Metal texture buffers (max 2^28 elements). Spider-Man 2
# views its 2 GB mesh pool through typed R32 views of 536M elements, so typed reads above 1 GB return 0
# (T-pose) and typed WRITES there are lost: the symbiote's spline meshes (Harry's / Venom's tendrils) are
# written into the pool by two compute shaders every frame and come out as garbage triangles, which also
# costs the GPU seconds per frame (the 60 -> 2 fps collapses in Harry's scenes, 2026-10-24/26/31).
# The shim (shims/d3d12shim/pool_fix.c) creates those views raw and swaps the four shaders that use them
# for copies whose typed loads/stores are raw ones. The copies are built here from the game's own exe, the
# way macprotips/SpiderMan2Fix (public domain) does it: extract the DXBC container by hash, `dxc -dumpbin`
# to LLVM IR text, rewrite the typed access (tools/sm2shaderfix, their C rewriter), `dxa` back to DXIL,
# `dxv` to validate and sign. Result hashes are the ones they verified in the game with the same DXC commit.
SM2_POOL_SHADERS = [  # (hash of the game's shader, register space, register, is UAV, verified result hash, name)
    (0x3d50acdb571dce22, 0, 1, False, 0x589ed5a9fddc545f, "CS_ModelSkinning"),
    (0x14902794dd7134e4, 0, 0, False, 0xee434fbf42f24d08, "vertex morph"),
    (0x9538ca33c087a84c, 0, 1, True, 0xce7b280115b2aa10, "CS_AnimSplineMeshGenIndices (symbiote)"),
    (0x125a4957ab64d24d, 0, 1, True, 0xb84c589e5ae4b5c5, "CS_AnimSplineMeshGenIndicesFinalize (symbiote)"),
]
SM2_SHADERFIX_SRC = os.path.join(HERE, "tools", "sm2shaderfix")
SM2_SHADERFIX_BIN = os.path.join(TOOLS, "sm2shaderfix")


def fnv1_64(data):
    h = 0xcbf29ce484222325
    for b in data:
        h = ((h * 0x100000001b3) & 0xffffffffffffffff) ^ b
    return h


def sm2_exe_path():
    for lib in steam_libraries(os.path.join(STEAM_DIR, "steamapps")):
        p = os.path.join(lib, "common", "Marvel's Spider-Man 2", "Spider-Man2.exe")
        if os.path.isfile(p):
            return p
    return None


def sm2_shader_file(h):
    return os.path.join(SM2_SHADER_DIR, f"sm2-pool-{h:016x}.dxil")


def sm2_shaders_missing():
    return [name for h, _, _, _, _, name in SM2_POOL_SHADERS if not os.path.isfile(sm2_shader_file(h))]


def dxc_tools_present():
    return all(os.access(os.path.join(DXC_DIR, "bin", t), os.X_OK) for t in ("dxc", "dxa", "dxv"))


def sm2_shaderfix_binary():
    """Compile tools/sm2shaderfix (plain C, POSIX regex) with the system clang when missing or stale."""
    srcs = [os.path.join(SM2_SHADERFIX_SRC, f) for f in ("main.c", "shaderfix.c")]
    if not all(os.path.isfile(s) for s in srcs):
        return None
    try:
        stale = not os.path.exists(SM2_SHADERFIX_BIN) or os.path.getmtime(SM2_SHADERFIX_BIN) < max(os.path.getmtime(s) for s in srcs + [os.path.join(SM2_SHADERFIX_SRC, "shaderfix.h")])
    except OSError:
        stale = True
    if stale:
        os.makedirs(TOOLS, exist_ok=True)
        r = run(["clang", "-O2", "-Wall", "-o", SM2_SHADERFIX_BIN] + srcs)
        if r.returncode != 0:
            bad("could not compile tools/sm2shaderfix: " + r.stderr.strip()[-400:])
            return None
    return SM2_SHADERFIX_BIN if os.access(SM2_SHADERFIX_BIN, os.X_OK) else None


def cmd_sm2_shaders(args):
    head("Spider-Man 2 pool-fix shaders (typed pool access -> raw; T-pose + symbiote)")
    exe = sm2_exe_path()
    present = [name for h, _, _, _, _, name in SM2_POOL_SHADERS if os.path.isfile(sm2_shader_file(h))]
    for h, _, _, _, _, name in SM2_POOL_SHADERS:
        (ok if os.path.isfile(sm2_shader_file(h)) else warn)(f"{name}: {'built' if os.path.isfile(sm2_shader_file(h)) else 'missing'} ({os.path.basename(sm2_shader_file(h))})")
    if args.status:
        info(f"folder: {SM2_SHADER_DIR}; the shim turns the fix on only when all {len(SM2_POOL_SHADERS)} files are present (log line 'pool fix: ON')")
        return
    if len(present) == len(SM2_POOL_SHADERS) and not args.force:
        ok("all shaders are built; use --force to rebuild them")
        return
    if not exe:
        die("Spider-Man 2 is not installed in the Windows Steam prefix (its Spider-Man2.exe is the source of the shaders)")
    if not dxc_tools_present():
        bad(f"Microsoft's shader tools (dxc, dxa, dxv) are not in {DXC_DIR}/bin")
        info("build them once (30-60 min, installs cmake + ninja with brew):  tools/dev/build-dxc.sh")
        info("then run this command again")
        sys.exit(2)
    tool = sm2_shaderfix_binary()
    if not tool:
        die("the rewrite tool is unavailable (see above)")
    import tempfile
    work = tempfile.mkdtemp(prefix="sm2-shaders-")
    os.makedirs(SM2_SHADER_DIR, exist_ok=True)
    built = 0
    env = dict(os.environ, DYLD_LIBRARY_PATH=os.path.join(DXC_DIR, "lib"))
    for h, space, reg, uav, want, name in SM2_POOL_SHADERS:
        if os.path.isfile(sm2_shader_file(h)) and not args.force:
            built += 1
            continue
        tag = f"{h:016x}"
        orig = os.path.join(work, tag + ".dxil"); ll = os.path.join(work, tag + ".ll"); edited = os.path.join(work, tag + "-raw.ll")
        asm = os.path.join(work, tag + "-raw.dxil"); signed = os.path.join(work, tag + "-signed.dxil")
        steps = [([tool, "extract", exe, tag, orig], "extract from the exe"),
                 ([os.path.join(DXC_DIR, "bin", "dxc"), "-dumpbin", orig, "-Fc", ll], "dxc -dumpbin"),
                 ([tool, "rewrite", ll, edited, str(space), str(reg), "uav" if uav else "srv"], "typed -> raw rewrite"),
                 ([os.path.join(DXC_DIR, "bin", "dxa"), "-o", asm, edited], "dxa"),
                 ([os.path.join(DXC_DIR, "bin", "dxv"), asm, "-o", signed], "dxv")]
        failed = None
        for cmd, what in steps:
            r = run(cmd, env=env, timeout=300)
            if r.returncode != 0:
                failed = f"{what}: {(r.stderr or r.stdout).strip()[-500:]}"
                break
        if failed:
            bad(f"{name}: {failed}")
            continue
        with open(signed, "rb") as f:
            data = f.read()
        got = fnv1_64(data)
        if data[:4] != b"DXBC":
            bad(f"{name}: dxv did not produce a DXBC container")
            continue
        if got != want:
            warn(f"{name}: result hash {got:016x} differs from the verified {want:016x} (a different DXC build?); installing it anyway, dxv validated it")
        replace_file(signed, sm2_shader_file(h))
        ok(f"{name}: built ({len(data)} bytes, hash {got:016x})")
        built += 1
    shutil.rmtree(work, ignore_errors=True)
    if built == len(SM2_POOL_SHADERS):
        ok(f"all {built} shaders in {SM2_SHADER_DIR}; the pool fix is on at the next launch (shim log: 'pool fix: ON')")
    else:
        bad(f"{built} of {len(SM2_POOL_SHADERS)} shaders built; the shim keeps the pool fix OFF until all are present")
        sys.exit(1)


