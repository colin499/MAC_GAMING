def xbox_controllers():
    """Return list of dicts for connected Xbox controllers (USB or Bluetooth)."""
    found = []
    # USB (wired USB-C). macOS 15+ has a native driver for wired Xbox pads.
    r = run(["system_profiler", "SPUSBDataType", "-json"])
    try:
        data = json.loads(r.stdout or "{}")
    except ValueError:
        data = {}

    def walk(items):
        for it in items or []:
            name = it.get("_name", "")
            vid = it.get("vendor_id", "")
            if "Xbox" in name or "Controller" in name and ("0x045e" in vid.lower() or "Microsoft" in it.get("manufacturer", "")):
                found.append({"name": name, "link": "USB", "battery": None})
            walk(it.get("_items"))
    walk(data.get("SPUSBDataType"))

    # Bluetooth
    r = run(["system_profiler", "SPBluetoothDataType", "-json"])
    try:
        bt = json.loads(r.stdout or "{}").get("SPBluetoothDataType", [{}])[0]
    except (ValueError, IndexError):
        bt = {}
    for entry in bt.get("device_connected", []) or []:
        for name, props in entry.items():
            minor = (props.get("device_minorType") or "").lower()
            vid = (props.get("device_vendorID") or "").lower()
            if "xbox" in name.lower() or "gamepad" in minor or vid == "0x045e":
                lvl = props.get("device_batteryLevelMain") or props.get("device_batteryLevel")
                found.append({"name": name, "link": "Bluetooth", "battery": lvl})
    return found


def paired_but_disconnected():
    r = run(["system_profiler", "SPBluetoothDataType", "-json"])
    try:
        bt = json.loads(r.stdout or "{}").get("SPBluetoothDataType", [{}])[0]
    except (ValueError, IndexError):
        return []
    names = []
    for entry in bt.get("device_not_connected", []) or []:
        for name, props in entry.items():
            minor = (props.get("device_minorType") or "").lower()
            vid = (props.get("device_vendorID") or "").lower()
            if "xbox" in name.lower() or "gamepad" in minor or vid == "0x045e":
                names.append(name)
    return names


def bluetooth_on():
    out = sh(["system_profiler", "SPBluetoothDataType"])
    m = re.search(r"State:\s*(\w+)", out)
    return (m.group(1).lower() == "on") if m else None


