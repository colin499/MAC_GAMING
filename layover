def library_snapshot(cfg, include_free=False):
    """Everything the library app shows, in one dict (fast: cached app info, no executable scans, no network)."""
    games_all = all_games()
    installed = {g["appid"]: g for g in games_all if g["where"] == "windows"}
    assets = parse_assetcache()
    dl_dir = os.path.join(STEAM_DIR, "steamapps", "downloading")
    try:
        pending_dl = {d for d in os.listdir(dl_dir) if d.isdigit()}
    except OSError:
        pending_dl = set()
    running = steam_running()
    running_dirs = running_game_installdirs() if running else set()
    running_game = next((a for a, g in installed.items() if g.get("installdir", "").lower() in running_dirs), None)
    games = []
    for o in owned_games(include_free=True, cfg=cfg):
        if not o["owned"] and not include_free:
            continue
        appid = o["appid"]
        g = installed.get(appid)
        gc = cfg["games"].get(appid, {})
        flags = g["flags"] if g else 0
        downloading = bool(flags & DOWNLOADING_BITS) or (g is None and appid in pending_dl)
        btd = (g or {}).get("bytes_to_download", 0)
        bd = (g or {}).get("bytes_downloaded", 0)
        progress = (bd / btd) if (downloading and btd) else (1.0 if g and g["ready"] else 0.0)
        dx12 = gc.get("dx12")
        renderer, why = renderer_for(cfg, appid, dx12)
        install_path = os.path.join(g["library"], "common", g["installdir"]) if g and g.get("installdir") else None
        games.append({
            "appid": appid, "name": o["name"], "type": o["type"], "where": "windows", "owned": o["owned"], "source": o["source"],
            "installed": g is not None, "ready": bool(g and g["ready"]), "needs_update": bool(g and g["needs_update"] and not downloading),
            "state_flags": flags, "state": [n for b, n in APP_STATE_BITS.items() if flags & b],
            "downloading": downloading, "paused": bool(flags & 512), "progress": round(min(max(progress, 0.0), 1.0), 4),
            "size": (g or {}).get("size", 0), "bytes_to_download": btd, "bytes_downloaded": bd,
            "bytes_to_stage": (g or {}).get("bytes_to_stage", 0), "bytes_staged": (g or {}).get("bytes_staged", 0),
            "installdir": (g or {}).get("installdir") or o.get("installdir", ""), "install_path": install_path,
            "buildid": (g or {}).get("buildid", ""), "last_updated": (g or {}).get("last_updated", 0),
            "last_played": max(o.get("last_played", 0), (g or {}).get("last_played", 0)), "playtime_min": o.get("playtime_min", 0),
            "running": appid == running_game,
            "renderer": renderer, "renderer_source": why, "dx12": dx12,
            "settings": {k: v for k, v in gc.items() if k in GAME_KEYS or k == "env"},
            "effective": {"renderer": renderer, "fps_cap": game_fps_cap(cfg, appid), "retina": effective_retina(cfg, appid),
                          "metalfx": game_metalfx(cfg, appid)},
            "profile": profile_status(cfg, appid, o.get("launch", [])),
            "covers": cover_paths(appid, assets), "cover_urls": cover_urls(appid),
            "compat": compat_cached(appid),
            "launch": o.get("launch", []), "launch_options": o.get("launch_options", ""),
            "oslist": o.get("oslist", ""), "controller_support": o.get("controller_support", ""),
            "deck_category": o.get("deck_category"), "release_state": o.get("release_state", ""),
            "developer": o.get("developer", ""), "publisher": o.get("publisher", ""), "dlc_owned": o.get("dlc_owned", []),
        })
    for g in games_all:   # native Mac Steam games (none on this Mac today, kept for completeness)
        if g["where"] != "mac":
            continue
        games.append({"appid": g["appid"], "name": g["name"], "type": "game", "where": "mac", "owned": True, "source": ["installed"],
                      "installed": True, "ready": g["ready"], "needs_update": g["needs_update"], "state_flags": g["flags"],
                      "state": [n for b, n in APP_STATE_BITS.items() if g["flags"] & b], "downloading": bool(g["flags"] & DOWNLOADING_BITS),
                      "paused": False, "progress": 1.0 if g["ready"] else 0.0, "size": g["size"], "bytes_to_download": 0, "bytes_downloaded": 0,
                      "bytes_to_stage": 0, "bytes_staged": 0, "installdir": g["installdir"], "install_path": None, "buildid": "",
                      "last_updated": 0, "last_played": g.get("last_played", 0), "playtime_min": 0, "running": False, "renderer": "native",
                      "renderer_source": "mac", "dx12": None, "settings": {}, "effective": {}, "profile": profile_status(cfg, g["appid"], []),
                      "covers": {k: None for k in COVER_KINDS}, "cover_urls": cover_urls(g["appid"]), "compat": compat_cached(g["appid"]),
                      "launch": [], "launch_options": "", "oslist": "macos", "controller_support": "", "deck_category": None,
                      "release_state": "", "developer": "", "publisher": "", "dlc_owned": []})
    accounts = []
    for sid, a in steam_accounts("windows").items():
        if isinstance(a, dict):
            accounts.append({"steamid": sid, "account_id": account_id(sid), "account_name": a.get("AccountName", ""),
                             "persona": a.get("PersonaName", ""), "most_recent": a.get("MostRecent") == "1"})
    st = running_state() if running else {}
    prompt = next((a for a in installed if steam_launch_prompt(a)), None) if running else None
    disk_path = STEAM_DIR if os.path.isdir(STEAM_DIR) else HOME
    vfs = os.statvfs(disk_path)
    owned_n = sum(1 for g in games if g["owned"])
    return {
        "schema": 1, "generated": _dt.datetime.now().isoformat(timespec="seconds"),
        "layover": {"version": VERSION, "engine": ENGINE_ID, "engine_ready": engine_ready(), "steam_installed": steam_installed(),
                    "root": ROOT, "covers_dir": COVERS, "repo": HERE, "d3d12_shim": bool(cfg.get("d3d12_shim", True)),
                    "renderer_default": cfg.get("renderer", "auto"), "fps_cap_default": cfg.get("fps_cap", 0)},
        "appcache": appcache_status(),
        "steam": {"running": running, "native_running": native_steam_running(), "connection": steam_connection_state() if running else None,
                  "offline": wants_offline(), "running_renderer": st.get("renderer"), "running_retina": st.get("retina"),
                  "running_game": running_game, "launch_prompt_appid": prompt, "accounts": accounts},
        "disk": {"path": disk_path, "free": vfs.f_bavail * vfs.f_frsize, "total": vfs.f_blocks * vfs.f_frsize},
        "counts": {"owned": owned_n, "installed": sum(1 for g in games if g["installed"]), "free": len(games) - owned_n,
                   "downloading": sum(1 for g in games if g["downloading"])},
        "games": games,
    }


def cmd_library(args):
    """Owned games (installed or not), with state, art and settings. `--json` is what Layover.app reads."""
    cfg = load_config()
    if args.refresh:
        for n in ("appinfo", "packageinfo"):
            _rm(os.path.join(CACHE_DIR, n + ".json"))
        web_owned_games(cfg, refresh=True)
    snap = library_snapshot(cfg, include_free=args.include_free)
    if args.fetch_covers:
        need = [g["appid"] for g in snap["games"] if g["where"] == "windows" and not (g["covers"].get("capsule") and g["covers"].get("hero"))]
        if need:
            spawn_detached(["covers", "--fetch"] + need[:80])
    if JSON_MODE:
        print(json.dumps(snap))
        return
    st = snap["steam"]
    head(f"Steam library  ·  Steam {'running' if st['running'] else 'off'}" + (f" · {st['connection']}" if st.get("connection") else "")
         + (" · offline mode" if st["offline"] else "") + f"  ·  {human(snap['disk']['free'])} free")
    for title, pick in (("Installed", lambda g: g["installed"]), ("Owned, not installed", lambda g: g["owned"] and not g["installed"]),
                        ("Free titles (not installed)", lambda g: not g["owned"] and not g["installed"])):
        rows = [g for g in snap["games"] if pick(g)]
        if not rows:
            continue
        print(paint(f"\n  {title}", C.B))
        for g in rows:
            if g["downloading"]:
                state = paint(f"downloading {g['progress'] * 100:.0f}%", C.Y)
            elif g["installed"]:
                state = paint("ready", C.G) if g["ready"] else paint("needs update/validation", C.Y)
            else:
                state = paint("not installed", C.D)
            comp = g["compat"]["label"] if g["compat"]["verdict"] != "unknown" else ""
            size = human(g["size"]) if g["size"] else ""
            print(f"  {g['appid']:>8}  {g['name']:<45} {size:>9}  {state:<28} {g['renderer']:<9} {comp}")
    if not args.include_free and snap["counts"]["free"] == 0:
        info("`layover library --include-free` also lists Steam's complimentary titles (TF2, Dota 2, ...)")
    print()


