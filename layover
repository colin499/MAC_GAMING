def localconfig_apps():
    """{appid: {last_played, playtime_min, launch_options}} from every account's localconfig.vdf (apps the
    account has touched: played, configured, launch options set)."""
    out = {}
    for p in localconfig_paths():
        try:
            with open(p, errors="replace") as f:
                root = parse_vdf(f.read())
        except OSError:
            continue
        apps = _kv(root, "UserLocalConfigStore", "Software", "Valve", "Steam", "apps", default={}) or {}
        for appid, a in apps.items():
            if not isinstance(a, dict) or not str(appid).isdigit():
                continue
            cur = out.setdefault(str(appid), {"last_played": 0, "playtime_min": 0, "launch_options": ""})
            for src, dst in (("LastPlayed", "last_played"), ("Playtime", "playtime_min")):
                try:
                    cur[dst] = max(cur[dst], int(a.get(src, 0) or 0))
                except (TypeError, ValueError):
                    pass
            if a.get("LaunchOptions"):
                cur["launch_options"] = str(a["LaunchOptions"])
    return out


def web_owned_games(cfg, refresh=False):
    """Optional exact list via the Steam Web API (config steam_api_key; the profile's Game Details must be
    public). Cached 24 h in cache/owned_web.json; only fetched by `layover library --refresh`. None if unset."""
    key = (cfg.get("steam_api_key") or "").strip()
    if not key:
        return None
    cpath = os.path.join(CACHE_DIR, "owned_web.json")
    try:
        with open(cpath) as f:
            c = json.load(f)
        if not refresh and time.time() - c.get("time", 0) < 86400:
            return c.get("games")
    except (OSError, ValueError):
        c = None
    if not refresh:
        return c.get("games") if c else None
    sid = next((s for s in steam_accounts("windows") if str(s).isdigit()), None)
    if not sid:
        return None
    url = (f"https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key={key}&steamid={sid}"
           "&include_appinfo=1&include_played_free_games=1&format=json")
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA}), timeout=8) as r:
            games = json.load(r).get("response", {}).get("games", [])
    except (OSError, ValueError):
        return c.get("games") if c else None
    res = {str(g["appid"]): {"name": g.get("name", ""), "playtime_min": g.get("playtime_forever", 0),
                             "last_played": g.get("rtime_last_played", 0)} for g in games if "appid" in g}
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(cpath, "w") as f:
            json.dump({"time": time.time(), "games": res}, f)
    except OSError:
        pass
    return res


