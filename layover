    binary = app_binary(quiet=False)
    run(["touch", APP_DIR])   # make Finder notice the icon
    if getattr(args, "snapshot", None):
        if not binary:
            die("no library app binary to snapshot")
        r = run([binary, "--snapshot", args.snapshot, "--wait-covers", "5"])
        print(r.stdout.strip() or r.stderr.strip())
        return
    ok(f"{APP_DIR} built (double-click it, or Spotlight → Layover)")
    info("the library window shows every game you own; Install, Play and Remove from there. Steam starts on its own if needed")


def cmd_app_launch(args):
    """What Layover.app runs: pick a game in a dialog, then play it. Errors go to a dialog, not a terminal."""
    try:
        app_log = os.path.join(LOGS, "app.log")
        if os.path.exists(app_log) and os.path.getsize(app_log) > (1 << 20):
            open(app_log, "w").close()   # the launcher appends forever; start over past 1 MB
    except OSError:
        pass
    try:
        cfg = load_config()
        if not (engine_ready() and steam_installed()):
            osa('display dialog "Layover is not set up yet. Open Terminal in the MAC_GAMING folder and run:  ./layover setup" buttons {"OK"} default button 1 with icon stop')
            return
        games = [g for g in all_games() if g["where"] == "windows"]
        games.sort(key=lambda g: g["name"].lower())
        names = [g["name"] for g in games if g["ready"]]
        status = f"STEAM {'ON' if steam_running() else 'OFF'} · {'FLIGHT MODE' if wants_offline() else 'ONLINE MODE'} · {len(names)} GAME{'S' if len(names) != 1 else ''} READY"
        # the plain dialog: only reached when the Swift library app could not be built (see cmd_app)
        items = names + MENU_ACTIONS
        lst = ", ".join('"' + n.replace('"', "'") + '"' for n in items)
        default = '"' + (names[0].replace('"', "'") if names else "Open Steam") + '"'
        pick = osa(f'choose from list {{{lst}}} with title "Layover" with prompt "What do you want to play? ({status.lower()})" default items {{{default}}} OK button name "Launch"')
        if not pick or pick == "false":
            return
        if pick == "Open Steam":
            cmd_steam(argparse.Namespace(offline=False, online=False, extra=[]))
            notify("Layover", "Steam is starting")
            return
        if pick == "Quit Steam":
            cmd_kill(argparse.Namespace())
            notify("Layover", "Steam closed")
            return
        if pick in ("Flight mode", "Back online"):
            offline = pick.startswith("Flight")
            if steam_running() or native_steam_running():
                if steam_running():
                    wineserver_kill(cfg)
                if native_steam_running():
                    subprocess.run(["osascript", "-e", 'tell application "Steam" to quit'], capture_output=True)
                for _ in range(30):
                    if not steam_running() and not native_steam_running():
                        break
                    time.sleep(1)
            for where in ("windows", "mac"):
                set_offline_mode(where, offline)
            if offline:
                missing = [g["name"] for g in games if not g["ready"]]
                msg = "Steam will start in OFFLINE mode (no internet needed). Open Layover again and pick a game to play."
                if missing:
                    msg += " Not ready for offline play (launch once while online): " + ", ".join(missing)
                osa(f'display dialog "{msg}" buttons {{"OK"}} default button 1 with title "Layover"')
            else:
                osa('display dialog "Steam will start in online mode again (cloud saves sync at the next launch)." buttons {"OK"} default button 1 with title "Layover"')
            return
        g = next((g for g in games if g["name"].replace('"', "'") == pick), None)
        if not g:
            die(f"game '{pick}' not found")
        notify("Layover", f"Launching {g['name']}" + ("" if steam_running() else " (starting Steam first, about 20 s)"))
        cmd_play(argparse.Namespace(game=g["appid"], offline=False))
    except SystemExit as e:
        if e.code not in (0, None):
            osa(f'display dialog "Layover could not launch that. See {LOGS}/app.log" buttons {{"OK"}} default button 1 with icon stop')
        raise
    except Exception as e:
        msg = str(e).replace('"', "'")[:300]
        osa(f'display dialog "Layover hit an error: {msg}" buttons {{"OK"}} default button 1 with icon stop')
        raise


