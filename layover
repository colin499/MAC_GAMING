</dict></plist>
""")
    launcher = os.path.join(macos, "Layover")
    with open(launcher, "w") as f:
        f.write(f"""#!/bin/zsh
# Layover.app: opens the library window (LayoverApp, Swift) which drives `layover` from the repo; without the
# Swift build it falls back to `layover app-launch` (a plain list dialog). Any python3 will do (stdlib only).
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
