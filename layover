# --------------------------------------------------------------------------- downloads
def download(url, dest, expected_sha=None, label=None):
    """Download with a progress line. Reuses the cached file if its hash matches."""
    label = label or os.path.basename(dest)
    if os.path.exists(dest) and (expected_sha is None or sha256(dest) == expected_sha):
        ok(f"{label} already downloaded")
        return dest
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".part"
    info(f"downloading {label}")
    req = urllib.request.Request(url, headers={"User-Agent": f"{APP_NAME}/{VERSION}"})
    with urllib.request.urlopen(req) as resp, open(tmp, "wb") as f:
        total = int(resp.headers.get("Content-Length") or 0)
        got = 0
        last = 0
        while True:
            chunk = resp.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            if tty() and (time.time() - last > 0.2):
                pct = f"{got * 100 // total}%" if total else ""
                sys.stdout.write(f"\r    {human(got)} / {human(total) if total else '?'} {pct}   ")
                sys.stdout.flush()
                last = time.time()
    if tty():
        sys.stdout.write("\r" + " " * 60 + "\r")
    if expected_sha:
        actual = sha256(tmp)
        if actual != expected_sha:
            os.remove(tmp)
            die(f"{label}: checksum mismatch\n      expected {expected_sha}\n      got      {actual}\n"
                "    The upstream file changed or the download was corrupted. Not installing it.")
    os.replace(tmp, dest)
    ok(f"{label} downloaded ({human(os.path.getsize(dest))})")
    return dest


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def extract(archive, dest):
    os.makedirs(dest, exist_ok=True)
    # macOS tar handles .xz and .gz and keeps symlinks/permissions intact.
    r = run(["tar", "-xf", archive, "-C", dest])
    if r.returncode != 0:
        die(f"extract failed: {r.stderr.strip()}")


# --------------------------------------------------------------------------- renderer choice
def game_uses_dx12(game):
    """Does this game need DirectX 12? Looks for the Agility SDK folder (D3D12/) or a
    *_dx12.dll next to the executables, then string-scans every .exe for its d3d12.dll /
    d3d11.dll imports. The scan reads whole files: Spider-Man 2's exe is 194 MB and its
    import table sits past the first 64 MB. Result is cached per AppID once known."""
    lib = game.get("library")
    installdir = game.get("installdir")
    if not lib or not installdir:
        return None
    root = os.path.join(os.path.dirname(lib), "steamapps", "common", installdir) if not lib.endswith("steamapps") else os.path.join(lib, "common", installdir)
    if not os.path.isdir(root):
        return None
    hits = {"d3d12": False, "d3d11": False}
    for dirpath, dirs, files in os.walk(root):
        if dirpath[len(root):].count(os.sep) > 2:
            dirs[:] = []
            continue
        if any(d.lower() == "d3d12" for d in dirs):      # DirectX 12 Agility SDK ships here
            hits["d3d12"] = True
        for fn in files:
            low = fn.lower()
            if low.endswith("_dx12.dll") or low == "d3d12core.dll":
                hits["d3d12"] = True
            if not low.endswith(".exe"):
                continue
            fp = os.path.join(dirpath, fn)
            try:
                if os.path.getsize(fp) < 512 * 1024:
                    continue
                with open(fp, "rb") as f:
                    tail = b""
                    while True:
                        chunk = f.read(16 << 20)
                        if not chunk:
                            break
                        blob = (tail + chunk).lower()
                        if b"d3d12.dll" in blob:
                            hits["d3d12"] = True
                        if b"d3d11.dll" in blob:
                            hits["d3d11"] = True
                        tail = chunk[-16:]
            except OSError:
                continue
    if hits["d3d12"]:
        return True
    if hits["d3d11"]:
        return False
    return None


def resolve_renderer(cfg, game=None, games=None):
    """Turn 'auto' into a concrete renderer. With a specific game: that game's need. Without
    one (plain `layover steam`): D3DMetal if any installed game needs DirectX 12, so that
    launching from inside Steam's own UI works for everything installed."""
    g = cfg["games"].get(str(game), {}) if game else {}
    choice = g.get("renderer") or cfg.get("renderer") or "auto"
    if choice != "auto":
        return choice
    games = games if games is not None else [x for x in all_games() if x["where"] == "windows"]
    targets = [x for x in games if str(x["appid"]) == str(game)] if game else games
    for x in targets:
        cached = cfg["games"].get(x["appid"], {}).get("dx12")
        if cached is None:
            cached = game_uses_dx12(x)
            if cached is not None:
                cfg["games"].setdefault(x["appid"], {})["dx12"] = cached
                save_config(cfg)
        if cached:
            return "d3dmetal"
    return "dxmt"


# --------------------------------------------------------------------------- wine plumbing
D3DMETAL_IDENTITIES = ("apple", "amd")


def registered_gpu():
    """(vendor, device, description) of the display adapter Wine registered in the prefix
    registry (HKLM\\System\\CurrentControlSet\\Enum\\PCI). Parsed from system.reg so no
    Wine process is needed. None if the prefix has not booted yet."""
    try:
        with open(os.path.join(PREFIX, "system.reg"), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    for m in re.finditer(r"^\[System\\\\(?:CurrentControlSet|ControlSet001)\\\\Enum\\\\PCI\\\\VEN_([0-9A-Fa-f]{4})&DEV_([0-9A-Fa-f]{4})[^\]]*\] \d+\n((?:[^\n]*\n)*?)\n", text, re.M):
        body = m.group(3)
        if '"Class"="Display"' not in body:
            continue
        desc = re.search(r'"DeviceDesc"="([^"]*)"', body)
        return int(m.group(1), 16), int(m.group(2), 16), (desc.group(1) if desc else "Apple GPU")
    return None


def wine_env(cfg, game=None, extra=None):
    """Environment for running anything in the Steam prefix.

    Mirrors what Highball does for this engine: runtime dylibs come from frameworks/ via the
    DYLD fallback paths, and a renderer is an overlay directory put in front of the engine's
    own DLLs with WINEDLLPATH_PREPEND (a CrossOver feature this build keeps)."""
    g = cfg["games"].get(str(game), {}) if game else {}
    renderer = (extra or {}).pop("LAYOVER_RENDERER", None) or resolve_renderer(cfg, game)
    if renderer not in RENDERER_CHOICES or renderer == "auto":
        renderer = "dxmt"
    msync = g.get("msync", cfg["msync"])
    gst = os.path.join(FRAMEWORKS, "GStreamer.framework", "Versions", "1.0")
    env = dict(os.environ)
    env.update({
        "WINEPREFIX": PREFIX,
        "WINEDEBUG": "-all",
        "WINE_LARGE_ADDRESS_AWARE": "1",
        "GST_DEBUG": "1",
        "DYLD_FALLBACK_FRAMEWORK_PATH": FRAMEWORKS,
        "DYLD_FALLBACK_LIBRARY_PATH": FRAMEWORKS + ":" + os.path.join(gst, "lib"),
        "GST_PLUGIN_PATH": os.path.join(gst, "lib", "gstreamer-1.0"),
        "CX_FWD_COMPAT_GL_CTX": "1",
        "DXMT_ALLOW_CROSS_PROCESS_SWAPCHAIN": "1",   # Steam overlay + DXMT
        "MVK_CONFIG_LOG_LEVEL": "0",
        "WINEDLLOVERRIDES": "winemenubuilder.exe=d",
        "PATH": WINE_BIN + ":" + env.get("PATH", ""),
    })
    env["WINEMSYNC"] = "1" if msync else "0"
    env["WINEESYNC"] = "0"
    audiobuf = os.path.join(FRAMEWORKS, "libhbaudiobuf.dylib")
    if cfg.get("audiobuf", True) and os.path.exists(audiobuf):
        env["DYLD_INSERT_LIBRARIES"] = audiobuf   # caps CoreAudio buffer: fixes crackling at 48 kHz
    if g.get("metal_hud", cfg["metal_hud"]):
        env["MTL_HUD_ENABLED"] = "1"
    if g.get("advertise_avx", cfg["advertise_avx"]):
        env["ROSETTA_ADVERTISE_AVX"] = "1"
    if not g.get("steam_overlay", cfg.get("steam_overlay", True)):
        env["WINEDLLOVERRIDES"] += ";gameoverlayrenderer64=d;gameoverlayrenderer=d"   # Steam can't inject its overlay
    overlays = []
    if renderer == "dxmt":
        overlays = [os.path.join(ENGINE_RENDERERS, "dxmt", "wine")]
    elif renderer == "d3dmetal":
        ext = os.path.join(ENGINE_RENDERERS, "d3dmetal", "external")
        overlays = [os.path.join(ENGINE_RENDERERS, "d3dmetal", "wine"), os.path.join(ENGINE_RENDERERS, "dxmt", "wine")]
        env["CX_D3DMETALPATH"] = ext
        env["DYLD_FALLBACK_LIBRARY_PATH"] += ":" + ext
        env["DYLD_FALLBACK_FRAMEWORK_PATH"] += ":" + ext
        if os.path.isfile(ags_shim_overlay_path()):
            env["WINEDLLOVERRIDES"] += ";amd_ags_x64=b"   # our AGS replacement beats the game's copy
        if d3d12_shim_installed() and cfg.get("d3d12_shim", True):
            overlays.insert(0, D3D12_SHIM_OVERLAY)
            env["WINEDLLOVERRIDES"] += ";d3d12=b;d3d12_d3dmetal=b"
            for fixes in GAME_FIXES.values():
                env.update(fixes)
        if g.get("d3dmetal_identity", cfg.get("d3dmetal_identity", "apple")) == "apple":
            gpu = registered_gpu()
            if gpu:
                env["D3DM_VENDOR_ID"] = "0x%04x" % gpu[0]
                env["D3DM_DEVICE_ID"] = "0x%04x" % gpu[1]
                env["D3DM_DEVICE_DESCRIPTION"] = gpu[2]
    if overlays:
        env["WINEDLLPATH_PREPEND"] = ":".join(overlays)
    fps = game_fps_cap(cfg, game)
    if fps and renderer in ("dxmt", "d3dmetal"):
        env["DXMT_CONFIG"] = f"d3d11.preferredMaxFrameRate={fps};"   # DXMT's limiter (D3D11 games); D3DMetal has none
        # D3D12 games under D3DMetal get the cap from our d3d12 shim (LAYOVER_MAX_FPS in d3d12shim.env, see write_shim_env)
    env["LAYOVER_RENDERER"] = renderer
    for k, v in (g.get("env") or {}).items():
        env[k] = str(v)
    if extra:
        env.update(extra)
    return env


def wine(cfg, args, game=None, wait=True, log=None, extra_env=None, cwd=None):
    env = wine_env(cfg, game, extra_env)
    out = open(log, "ab") if log else subprocess.DEVNULL
    p = subprocess.Popen([WINE] + args, env=env, stdout=out, stderr=subprocess.STDOUT,
                         cwd=cwd, start_new_session=not wait)
    if wait:
        p.wait()
        return p.returncode
    return p


def wineserver_wait(cfg):
    subprocess.run([WINESERVER, "-w"], env=wine_env(cfg), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def close_games(cfg, wait=20):
    """Ask running games to close (WM_CLOSE, like clicking the window's close button) and wait a little.
    A game that is killed instead leaves Steam's "cloud sync failed" prompt for the next launch."""
    exes = running_game_exes()
    if not exes:
        return
    for exe in exes:
        wine(cfg, ["taskkill", "/IM", exe])
    for _ in range(wait):
        if not running_game_exes():
            return
        time.sleep(1)


def running_game_exes():
    """Basenames of game executables running in our prefix (from the Mac process list)."""
    out = sh(["ps", "-axo", "command"])
    found = set()
    for line in out.splitlines():
        if "steamapps/common" in line and ".exe" in line and "crs-" not in line:
            exe = line.split(".exe")[0].rsplit("/", 1)[-1].rsplit("\\", 1)[-1] + ".exe"
            found.add(exe)
    return sorted(found)


def wineserver_kill(cfg):
    close_games(cfg)
    subprocess.run([WINESERVER, "-k"], env=wine_env(cfg), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reg_add(cfg, key, name, value, kind="REG_SZ"):
    return wine(cfg, ["reg", "add", key, "/v", name, "/t", kind, "/d", str(value), "/f"])


def registry_value(key_path, name):
    """Read a string value from the prefix's user.reg without starting Wine (None if absent)."""
    try:
        with open(os.path.join(PREFIX, "user.reg"), errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    # user.reg writes the key with doubled backslashes: [Software\\Wine\\Mac Driver] <timestamp>
    m = re.search(r'^\[' + re.escape(key_path.replace("\\", "\\\\")) + r'\][^\n]*\n(.*?)(?=^\[|\Z)', text, re.M | re.S)
    if not m:
        return None
    v = re.search(r'^"' + re.escape(name) + r'"="([^"]*)"', m.group(1), re.M)
    return v.group(1) if v else None


def apply_retina(cfg):
    """Make Wine's Mac driver match config `retina` (3456x2234 vs 1728x1117 on this MacBook).
    Each Wine process reads the key at start, so this also works while Steam is up (next game launch)."""
    want = "y" if cfg.get("retina") else "n"
    if registry_value(r"Software\Wine\Mac Driver", "RetinaMode") == want:
        return False
    reg_add(cfg, r"HKCU\Software\Wine\Mac Driver", "RetinaMode", want)
    return True


SHIM_ENV_PATH = os.path.join(PREFIX, "drive_c", "windows", "system32", "d3d12shim.env")


def game_fps_cap(cfg, game=None):
    g = cfg["games"].get(str(game), {}) if game else {}
    try:
        return int(g.get("fps_cap", cfg.get("fps_cap", 0)) or 0)
    except (TypeError, ValueError):
        return 0


def write_shim_env(cfg, game=None):
    """Settings file the d3d12 shim reads in DllMain (KEY=VALUE; only sets variables that are unset).
    Needed because a Steam-launched game inherits Steam's environment, not ours. Rewritten at every
    launch: a fresh log per run (logs/d3d12-<stamp>.log) plus games.<appid>.env from config.json."""
    if not os.path.isdir(os.path.dirname(SHIM_ENV_PATH)):
        return None
    log = new_log("d3d12")
    lines = ["LAYOVER_D3D12_LOG=Z:" + log.replace("/", "\\"), "LAYOVER_SKIN_LOG=1", f"LAYOVER_MAX_FPS={game_fps_cap(cfg, game)}"]
    g = cfg["games"].get(str(game), {}) if game else {}
    for k, v in (g.get("env") or {}).items():
        if k.startswith(("LAYOVER_", "D3DM_", "HB_")):
            lines.append(f"{k}={v}")
    try:
        with open(SHIM_ENV_PATH, "w") as f:
            f.write("\n".join(lines) + "\n")
    except OSError:
        return None
    return log


def new_log(name):
    os.makedirs(LOGS, exist_ok=True)
    stamp = _dt.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    path = os.path.join(LOGS, f"{name}-{stamp}.log")
    # keep the 20 most recent logs (any kind: steam-*, d3d12-*, setup-*)
    old = sorted((p for p in os.listdir(LOGS) if p.endswith(".log")), key=lambda p: os.path.getmtime(os.path.join(LOGS, p)))
    for p in old[:-20]:
        try:
            os.remove(os.path.join(LOGS, p))
        except OSError:
            pass
    return path


