# Steam's UI is a Chromium (CEF) process. Under Wine on Apple Silicon its renderer paints
# the window black and its network service trips over winsock. Forcing CEF into
# "--disable-gpu --single-process" fixes both (finding from notpop/steam-on-m1-wine, MIT).
# Steam ignores its own -cef-single-process flag nowadays, so we rename Valve's
# steamwebhelper.exe to steamwebhelper_real.exe and drop in a tiny wrapper that adds the
# flags and execs the real one. Steam's startup verification would restore the original,
# hence the -noverifyfiles family of flags in steam_args.
WRAPPER_SRC_DIR = os.path.join(HERE, "wrapper")
WRAPPER_EXE = os.path.join(WRAPPER_SRC_DIR, "steamwebhelper.exe")
WRAPPER_MAX_SIZE = 500_000   # Valve's helper is ~7 MB; ours is ~150 KB
MINGW_GCC = "/opt/homebrew/bin/x86_64-w64-mingw32-gcc"


WRAPPER_INSTALLED = os.path.join(TOOLS, "steamwebhelper.exe")

# AMD AGS replacement. D3DMetal presents itself as an AMD GPU, so games that bundle AMD's
# AGS runtime (amd_ags_x64.dll) initialise it; the real one needs AMD's ADL driver library and
# fails under Wine, which Spider-Man 2 reports as "No installed graphics card has been
# detected". Our build answers from DXGI and creates DX12 devices with plain D3D12CreateDevice.
# It is marked as a Wine builtin and selected with WINEDLLOVERRIDES amd_ags_x64=b when D3DMetal
# is the renderer (see shims/amd_ags).
AGS_SHIM_SRC_DIR = os.path.join(HERE, "shims", "amd_ags")
AGS_SHIM_DLL = os.path.join(AGS_SHIM_SRC_DIR, "amd_ags_x64.dll")
AGS_SHIM_INSTALLED = os.path.join(TOOLS, "amd_ags_x64.dll")
MINGW_GXX = "/opt/homebrew/bin/x86_64-w64-mingw32-g++"


def ags_shim_binary():
    """Path to the AGS replacement DLL, kept under Application Support like the wrapper."""
    os.makedirs(TOOLS, exist_ok=True)
    try:
        if not os.path.exists(AGS_SHIM_DLL) and os.path.exists(MINGW_GXX) and os.path.isdir(AGS_SHIM_SRC_DIR):
            subprocess.run(["make", "-s", "-C", AGS_SHIM_SRC_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(AGS_SHIM_DLL) and os.path.getsize(AGS_SHIM_DLL) > 0:
            if not os.path.exists(AGS_SHIM_INSTALLED) or os.path.getsize(AGS_SHIM_INSTALLED) != os.path.getsize(AGS_SHIM_DLL):
                shutil.copy2(AGS_SHIM_DLL, AGS_SHIM_INSTALLED)
    except PermissionError:
        pass   # Documents not readable from this session; use whatever copy exists
    return AGS_SHIM_INSTALLED if os.path.exists(AGS_SHIM_INSTALLED) else None


# d3d12shim: our d3d12.dll in front of D3DMetal's (shims/d3d12shim). It carries per-game fixes and an
# optional D3D12 call trace. Laid out like Highball's tsshim: an overlay dir listed FIRST in
# WINEDLLPATH_PREPEND holding d3d12.dll (ours) and d3d12_d3dmetal.dll (D3DMetal's, renamed; Wine
# resolves builtins by base name), x86_64-unix/d3d12_d3dmetal.so -> libd3dshared.dylib, a system32
# placeholder of that name in the prefix, and WINEDLLOVERRIDES d3d12=b;d3d12_d3dmetal=b.
D3D12_SHIM_SRC_DIR = os.path.join(HERE, "shims", "d3d12shim")
D3D12_SHIM_DLL = os.path.join(D3D12_SHIM_SRC_DIR, "d3d12.dll")
D3D12_SHIM_INSTALLED = os.path.join(TOOLS, "d3d12shim.dll")
D3D12_SHIM_OVERLAY = os.path.join(ENGINE_RENDERERS, "d3d12shim", "wine")
MINGW_GCC = "/opt/homebrew/bin/x86_64-w64-mingw32-gcc"
# Per-game environment applied whenever D3DMetal is the renderer (the shim checks the exe name itself).
# 2651280 Marvel's Spider-Man 2: its 2046 MB "ManagedBuffer" pool is viewed through typed buffers of
# more than 2^28 elements, which Metal cannot do; D3DMetal clamps them and every character whose data
# lands above the clamp stays in its bind pose (T-pose). The shim shrinks the pool to 1022 MB.
# Status 2026-10-08 evening: the shim now fixes this by itself (sm2_skin.c, on by default for
# Spider-Man2.exe): skinned models' GPU blobs are moved into a subheap in the first 1 GB of the pool.
# Nothing to set here; knobs LAYOVER_SKIN_MB / LAYOVER_IMPOSTOR_MB / LAYOVER_PLUG / LAYOVER_SKIN_LOG
# can go into games.2651280.env in config.json or the prefix's windows/system32/d3d12shim.env.
# (LAYOVER_MANAGED_MB=1022 was the earlier experiment: animates, but the city overflows 1 GB.)
GAME_FIXES = {}


