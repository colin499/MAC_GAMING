# --------------------------------------------------------------------------- helpers
class C:
    B = "\033[1m"; G = "\033[32m"; Y = "\033[33m"; R = "\033[31m"; D = "\033[2m"; X = "\033[0m"


def tty():
    return sys.stdout.isatty()


def paint(s, col):
    return f"{col}{s}{C.X}" if tty() else s


def ok(msg): print(paint("  ✓ ", C.G) + msg)
def warn(msg): print(paint("  ! ", C.Y) + msg)
def bad(msg): print(paint("  ✗ ", C.R) + msg)
def info(msg): print(paint("  · ", C.D) + msg)
def head(msg): print("\n" + paint(msg, C.B))


def die(msg, code=1):
    bad(msg)
    sys.exit(code)


def run(cmd, **kw):
    kw.setdefault("text", True)
    kw.setdefault("capture_output", True)
    return subprocess.run(cmd, **kw)


def sh(cmd):
    r = run(cmd)
    return r.stdout.strip()


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


