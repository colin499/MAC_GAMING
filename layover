def _merge_profile(dst, src):
    for k, v in src.items():
        if k in ("settings", "env"):
            dst.setdefault(k, {}).update(v)
        elif k in ("notes", "ini", "checks"):
            dst.setdefault(k, []).extend(x for x in v if x not in dst.get(k, []))
        else:
            dst[k] = v
    return dst


def profile_for(appid, launch_exes=()):
    """The merged profile for a game (exe-glob entries first, the AppID entry last) or None."""
    merged = {}
    exes = [os.path.basename(str(e)).lower() for e in launch_exes if e]
    for key, prof in PROFILES.items():
        if key.startswith("exe:") and any(fnmatch.fnmatch(e, key[4:].lower()) for e in exes):
            _merge_profile(merged, prof)
    if str(appid) in PROFILES:
        _merge_profile(merged, PROFILES[str(appid)])
    return merged or None


def profile_version(profile):
    return hashlib.sha1(json.dumps(profile, sort_keys=True).encode()).hexdigest()[:12]


def prefix_documents():
    """The Windows user's Documents folder inside the prefix (C:\\users\\<you>\\Documents)."""
    users = os.path.join(PREFIX, "drive_c", "users")
    cands = [os.environ.get("USER", ""), os.path.basename(HOME)]
    try:
        cands += [d for d in sorted(os.listdir(users)) if d not in ("Public", "")]
    except OSError:
        pass
    for c in cands:
        p = os.path.join(users, c, "Documents")
        if c and os.path.isdir(p):
            return p
    return os.path.join(users, os.environ.get("USER", "user"), "Documents")


def profile_ini_path(spec, game=None):
    if spec.startswith("Documents/"):
        return os.path.join(prefix_documents(), spec[len("Documents/"):])
    if spec.startswith("installdir:"):
        root = game_root(game) if game else None
        return os.path.join(root, spec[len("installdir:"):]) if root else None
    return os.path.join(PREFIX, "drive_c", spec)


def ini_set(path, section, values):
    """Set keys in [section] of an INI file in place, keeping order, comments and line endings; missing keys are
    appended to the section. A <file>.bak-layover copy is made once. Returns the number of lines changed."""
    with open(path, "rb") as f:
        raw = f.read()
    nl = "\r\n" if b"\r\n" in raw else "\n"
    lines = raw.decode("utf-8", "replace").split(nl)
    want = {k.lower(): (k, str(v)) for k, v in values.items()}
    out, done = [], set()
    in_sec = found = False
    changed = 0

    def flush_missing():
        nonlocal changed
        # insert before trailing blank lines so the section stays tidy
        tail = []
        while out and out[-1].strip() == "":
            tail.insert(0, out.pop())
        for lk, (k, v) in want.items():
            if lk not in done:
                out.append(f"{k}={v}")
                done.add(lk)
                changed += 1
        out.extend(tail)

    for line in lines:
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            if in_sec:
                flush_missing()
            in_sec = s[1:-1].strip().lower() == section.lower()
            found = found or in_sec
            out.append(line)
            continue
        if in_sec and "=" in line and not s.startswith((";", "#")):
            k, _, v = line.partition("=")
            lk = k.strip().lower()
            if lk in want and lk not in done:
                nv = want[lk][1]
                if v.strip() != nv:
                    line = f"{k.strip()}={nv}"
                    changed += 1
                done.add(lk)
        out.append(line)
    if in_sec:
        flush_missing()
    if not found:
        if out and out[-1].strip() != "":
            out.append("")
        out.append(f"[{section}]")
        in_sec = True
        flush_missing()
    if changed:
        bak = path + ".bak-layover"
        if not os.path.exists(bak):
            shutil.copy2(path, bak)
        with open(path, "wb") as f:
            f.write(nl.join(out).encode("utf-8"))
    return changed


def set_launch_options(appid, text):
    """Write Steam's per-game Launch Options into localconfig.vdf. Only while Steam is fully stopped (it rewrites
    the file on exit); returns the number of files changed."""
    if steam_running() or prefix_running():
        die("Steam must be closed before launch options can be written (layover kill)", 6)
    n = 0
    for p in localconfig_paths():
        with open(p, errors="replace") as f:
            src = f.read()
        m = re.search(r'("Software"\s*\{\s*"[Vv]alve"\s*\{\s*"[Ss]team"\s*\{\s*"[Aa]pps"\s*\{)', src)
        if not m:
            continue
        esc = text.replace("\\", "\\\\").replace('"', '\\"')
        block = re.search(r'(\n(\t*)"%s"\s*\{)(.*?)(\n\2\})' % re.escape(str(appid)), src[m.end():], re.S)
        if block:
            start = m.end() + block.start()
            body = block.group(3)
            if re.search(r'"LaunchOptions"\s+"', body):
                body = re.sub(r'("LaunchOptions"\s+")(?:[^"\\]|\\.)*(")', lambda mm: mm.group(1) + esc + mm.group(2), body, count=1)
            else:
                body += f'\n{block.group(2)}\t"LaunchOptions"\t\t"{esc}"'
            new = src[:start] + block.group(1) + body + block.group(4) + src[m.end() + block.end():]
        else:
            indent = "\t" * 5
            new = src[:m.end()] + f'\n{indent}"{appid}"\n{indent}{{\n{indent}\t"LaunchOptions"\t\t"{esc}"\n{indent}}}' + src[m.end():]
        if new != src:
            with open(p, "w") as f:
                f.write(new)
            n += 1
    return n


def apply_profile(cfg, appid, force=False, game=None):
    """Apply a game's profile: settings (where the user has none, or all with force), env, INI edits (when the
    file exists; otherwise remembered as pending), launch options (only with Steam stopped). Returns a report."""
    appid = str(appid)
    info = find_owned(appid) or {}
    prof = profile_for(appid, [l.get("exe") for l in info.get("launch", [])])
    rep = {"appid": appid, "available": bool(prof), "settings": [], "kept": [], "ini": [], "pending_ini": False, "launch_options": None}
    if not prof:
        return rep
    g = cfg["games"].setdefault(appid, {})
    for k, v in (prof.get("settings") or {}).items():
        if k in g and g[k] != v and not force and g.get("profile_set", {}).get(k) != g[k]:
            rep["kept"].append(k)          # the user's own, different value stays
            continue
        g[k] = v
        g.setdefault("profile_set", {})[k] = v
        rep["settings"].append(k)
    if prof.get("env"):
        env = g.setdefault("env", {})
        for k, v in prof["env"].items():
            if k not in env or force:
                env[k] = str(v)
    installed = game or next((x for x in all_games() if x["appid"] == appid and x["where"] == "windows"), None)
    for spec in prof.get("ini") or []:
        path = profile_ini_path(spec["file"], installed)
        if not path or not os.path.isfile(path):
            rep["pending_ini"] = True          # the game writes it on its first run; retried at the next play
            rep["ini"].append({"file": spec["file"], "status": "not there yet"})
            continue
        try:
            n = ini_set(path, spec["section"], spec["set"])
            rep["ini"].append({"file": spec["file"], "status": f"{n} line{'s' if n != 1 else ''} changed" if n else "already as recommended"})
        except OSError as e:
            rep["ini"].append({"file": spec["file"], "status": f"failed: {e}"})
    if prof.get("launch_options") and (force or not info.get("launch_options")):
        if steam_running() or prefix_running():
            rep["launch_options"] = "skipped (Steam running)"
        else:
            rep["launch_options"] = f"{set_launch_options(appid, prof['launch_options'])} file(s) written"
    g["profile_applied"] = profile_version(prof)
    g["profile_pending_ini"] = rep["pending_ini"]
    if not g["profile_pending_ini"]:
        g.pop("profile_pending_ini", None)
    save_config(cfg)
    return rep


def profile_status(cfg, appid, launch):
    """For the library listing: is there a profile, is it applied, its notes."""
    prof = profile_for(appid, [l.get("exe") if isinstance(l, dict) else l for l in (launch or [])])
    if not prof:
        return {"available": False, "applied": None, "version": None, "pending_ini": False, "notes": []}
    g = cfg["games"].get(str(appid), {})
    ver = profile_version(prof)
    return {"available": True, "applied": g.get("profile_applied") == ver, "version": ver,
            "pending_ini": bool(g.get("profile_pending_ini")), "notes": prof.get("notes", []),
            "settings": prof.get("settings", {}), "launcher": prof.get("launcher")}


def apply_profile_if_pending(cfg, appid):
    """Called by `play`: first launch (or a changed profile, or an INI the game had not written yet) applies it."""
    st = profile_status(cfg, appid, (find_owned(str(appid)) or {}).get("launch", []))
    if not st["available"] or (st["applied"] and not st["pending_ini"]):
        return False
    rep = apply_profile(cfg, appid)
    bits = []
    if rep["settings"]:
        bits.append("settings " + ", ".join(rep["settings"]))
    for i in rep["ini"]:
        bits.append(f"{os.path.basename(i['file'])}: {i['status']}")
    if bits:
        info(f"applied Layover's profile for this game ({'; '.join(bits)})")
    return True


def profile_warnings(appid):
    """(level, message) pairs from a profile's checks (used by `layover flight` and the listing)."""
    out = []
    prof = profile_for(appid)
    for check in (prof or {}).get("checks", []):
        if check == "sm2_shaders" and sm2_exe_path():
            missing = sm2_shaders_missing()
            if missing:
                out.append(("warn", f"Spider-Man 2 pool-fix shaders not built ({len(missing)} missing): the symbiote scenes glitch and drop to 2 fps"
                            + (" — run tools/dev/build-dxc.sh (once, 30-60 min), then layover sm2-shaders" if not dxc_tools_present() else " — run layover sm2-shaders")))
            else:
                out.append(("ok", "Spider-Man 2 pool-fix shaders built (symbiote + T-pose fix at the root)"))
    return out


def cmd_profile(args):
    """Show or apply Layover's recommended settings for a game."""
    cfg = load_config()
    g = find_any_game(args.game)
    if not g:
        die(f"no game matches '{args.game}' (layover library)", 3)
    appid = g["appid"]
    info_ = find_owned(appid) or {}
    prof = profile_for(appid, [l.get("exe") for l in info_.get("launch", [])])
    if args.apply or args.reset:
        rep = apply_profile(cfg, appid, force=args.reset, game=g if g.get("installed", True) and g.get("library") else None)
        if JSON_MODE:
            print(json.dumps({"ok": True, "report": rep, "status": profile_status(cfg, appid, info_.get("launch", []))}))
            return
        if not rep["available"]:
            info(f"no profile for {g['name']}; nothing to apply")
            return
        ok(f"{g['name']}: profile {'reset' if args.reset else 'applied'}")
        if rep["settings"]:
            info("settings set: " + ", ".join(rep["settings"]))
        if rep["kept"]:
            info("your own values kept: " + ", ".join(rep["kept"]) + " (--reset replaces them)")
        for i in rep["ini"]:
            info(f"{i['file']}: {i['status']}")
        if rep["launch_options"]:
            info(f"launch options: {rep['launch_options']}")
        return
    st = profile_status(cfg, appid, info_.get("launch", []))
    if JSON_MODE:
        print(json.dumps({"ok": True, "appid": appid, "name": g["name"], "profile": prof, "status": st}))
        return
    head(g["name"])
    if not prof:
        info("no bundled profile; the defaults apply (renderer by DirectX version, global fps cap/retina)")
        return
    info(("applied" if st["applied"] else "not applied yet (happens at the next play)") + (", INI edit pending" if st["pending_ini"] else ""))
    if prof.get("settings"):
        info("settings: " + ", ".join(f"{k}={v}" for k, v in prof["settings"].items()))
    for spec in prof.get("ini", []):
        info(f"{spec['file']} [{spec['section']}]: " + ", ".join(f"{k}={v}" for k, v in spec["set"].items()))
    if prof.get("launcher"):
        info(f"launcher: {prof['launcher'].get('exe', '')} — {prof['launcher'].get('note', '')}")
    for n in prof.get("notes", []):
        info("note: " + n)
    for level, msg in profile_warnings(appid):
        (warn if level == "warn" else ok)(msg)


