def remove_legacy_engines():
    """Delete engine folders from earlier experiments (2+ GB). Only while nothing runs in the prefix."""
    if steam_running() or prefix_running():
        return
    for old in LEGACY_ENGINES + [RENDERERS]:
        if os.path.isdir(old):
