APP_DIR = os.path.expanduser("~/Applications/Layover.app")
APP_SRC_ICON = os.path.join(HERE, "app", "Layover.icns")
APP_SRC_DIR = os.path.join(HERE, "app", "LayoverApp")                  # the library window (AppKit, Swift)
APP_BIN = os.path.join(APP_DIR, "Contents", "MacOS", "LayoverApp")
APP_BUILD_STAMP = os.path.join(APP_DIR, "Contents", "Resources", "LayoverApp.sources")
MENU_ACTIONS = ["Open Steam", "Quit Steam", "Flight mode", "Back online"]   # the no-Swift fallback dialog


def app_sources():
    return sorted(glob.glob(os.path.join(APP_SRC_DIR, "*.swift")))


def app_binary(quiet=True):
    """Compile app/LayoverApp/*.swift into the bundle when missing or stale (newest source, or a changed file
    list). Returns the path or None. The Command Line Tools' newest SDK can be ahead of their swiftc (seen
    2026-10-11: SDK 26.2 vs Swift 6.1.2 -> "this SDK is not supported by the compiler"), so the MacOSX15+
    SDKs in the same folder are tried from newest to oldest."""
    srcs = app_sources()
    if not srcs:
        return None
    stamp = "\n".join(os.path.basename(p) for p in srcs)
    try:
        newest = max(os.path.getmtime(p) for p in srcs)
        with open(APP_BUILD_STAMP) as f:
            same_list = f.read() == stamp
        if same_list and os.path.exists(APP_BIN) and os.path.getmtime(APP_BIN) >= newest:
            return APP_BIN
    except OSError:
        pass
    os.makedirs(os.path.dirname(APP_BIN), exist_ok=True)
    os.makedirs(os.path.dirname(APP_BUILD_STAMP), exist_ok=True)
    if not quiet:
        info("building the library app (swiftc, about 20 s)")
    sdks = [None] + sorted(glob.glob("/Library/Developer/CommandLineTools/SDKs/MacOSX1[5-9]*.sdk"), reverse=True)
    last_err = ""
    for sdk in sdks:
        cmd = ["xcrun", "swiftc", "-O", "-swift-version", "5", "-target", "arm64-apple-macosx14.0", "-module-name", "LayoverApp"] \
            + (["-sdk", sdk] if sdk else []) + ["-framework", "AppKit", "-o", APP_BIN] + srcs
        r = run(cmd)
        if r.returncode == 0 and os.path.exists(APP_BIN):
            with open(APP_BUILD_STAMP, "w") as f:
                f.write(stamp)
            for old in ("LayoverMenu",):   # the pre-2026-11 pinball menu binary
                try:
                    os.remove(os.path.join(os.path.dirname(APP_BIN), old))
                except OSError:
                    pass
            if not quiet:
                ok("library app built" + (f" (SDK {os.path.basename(sdk)})" if sdk else ""))
            return APP_BIN
        errs = [l for l in (r.stderr or "").splitlines() if "error:" in l]
        if errs and "not supported by the compiler" not in r.stderr:
            last_err = errs[0]
            break   # a real compile error: other SDKs will not help
    if not quiet:
        warn("could not build the library app (swiftc)" + (f": {last_err[:160]}" if last_err else "") + "; Layover.app falls back to a plain list dialog")
    return None


def osa(script):
    """Run AppleScript, return its stdout (empty string if the user cancelled)."""
    r = run(["osascript", "-e", script])
    return r.stdout.strip() if r.returncode == 0 else ""


def notify(title, text):
    run(["osascript", "-e", f'display notification "{text}" with title "{title}"'])


def cmd_app(args):
    """Build ~/Applications/Layover.app: a double-clickable app (no Terminal) that launches a game."""
    macos = os.path.join(APP_DIR, "Contents", "MacOS"); res = os.path.join(APP_DIR, "Contents", "Resources")
    os.makedirs(macos, exist_ok=True); os.makedirs(res, exist_ok=True)
    with open(os.path.join(APP_DIR, "Contents", "Info.plist"), "w") as f:
        f.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Layover</string>
  <key>CFBundleDisplayName</key><string>Layover</string>
  <key>CFBundleIdentifier</key><string>local.layover.launcher</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>Layover</string>
  <key>CFBundleIconFile</key><string>Layover</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
