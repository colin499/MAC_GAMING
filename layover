def cmd_setup(args):
    head(f"{APP_NAME} setup")
    if not is_apple_silicon():
        die("Layover needs an Apple Silicon Mac.")
    major = int(mac_version().split(".")[0])
    if major < 14:
        die("macOS 14 Sonoma or newer is required (DXMT needs Metal 3).")
    ensure_dirs()
    cfg = load_config()
    save_config(cfg)

    # 1. Rosetta
    if rosetta_installed():
        ok("Rosetta 2 present")
    else:
        info("installing Rosetta 2 (Apple will ask you to agree to its license)")
        r = subprocess.run(["softwareupdate", "--install-rosetta", "--agree-to-license"])
        if r.returncode != 0 or not rosetta_installed():
            die("Rosetta install failed. Run manually:  softwareupdate --install-rosetta --agree-to-license")
        ok("Rosetta 2 installed")

    # 2. Engine (Wine + runtime + DXMT + D3DMetal in one go)
    if engine_ready() and renderer_installed("dxmt") and renderer_installed("d3dmetal") and not args.reinstall:
        ok(f"engine present: {engine_version()}")
    else:
        info("D3DMetal (inside the runtime bundle) is Apple-licensed for non-commercial use only:")
        info("  https://github.com/user-attachments/files/23971305/License.pdf")
        assemble_engine()
        if not engine_ready():
            die("engine layout unexpected after extraction")
        ok(f"engine installed: {engine_version()}")
    for r in RENDERER_CHOICES:
        (ok if renderer_installed(r) else bad)(f"renderer {r}")
    for old in LEGACY_ENGINES:
        if os.path.isdir(old):
            if steam_running():
                info(f"old engine {os.path.basename(old)} still in use by the running Steam; removed on the next setup")
            else:
                shutil.rmtree(old, ignore_errors=True)
                shutil.rmtree(RENDERERS, ignore_errors=True)
                info(f"removed old engine {os.path.basename(old)}")

    # 4. Prefix
    if os.path.isdir(os.path.join(PREFIX, "drive_c")) and not args.reinstall:
        ok("Steam prefix present")
    else:
        info("creating the Windows environment (prefix) — about 30 seconds")
        os.makedirs(PREFIX, exist_ok=True)
        log = new_log("setup")
        env = wine_env(cfg)
        r = subprocess.run([WINE, "wineboot", "--init"], env=env, stdout=open(log, "ab"), stderr=subprocess.STDOUT)
        wineserver_wait(cfg)
        if r.returncode != 0 or not os.path.isdir(os.path.join(PREFIX, "drive_c")):
            die(f"prefix creation failed, see {log}")
        reg_add(cfg, r"HKCU\Software\Wine\Mac Driver", "RetinaMode", "y" if cfg["retina"] else "n")
        # Steam's web UI is happier at Windows 10; wineboot default is already win10, set explicitly.
        wine(cfg, ["winecfg", "-v", "win10"])
        wineserver_wait(cfg)
        ok("prefix ready")

    # 5. Steam
    install_ags_shim(quiet=False)
    install_d3d12_shim(quiet=False)

    if steam_installed() and not args.reinstall:
        ok("Windows Steam present")
    else:
        setup_exe = download(STEAM_SETUP_URL, os.path.join(CACHE, "SteamSetup.exe"), None, "Steam installer")
        info("installing Steam silently")
        log = new_log("steam-install")
        wine(cfg, [setup_exe, "/S"], log=log)
        wineserver_wait(cfg)
        if not steam_installed():
            die(f"Steam install failed, see {log}")
        ok("Windows Steam installed")
    if cfg.get("webhelper_wrapper", False):
        install_webhelper_wrapper(quiet=False)

    print()
    ok(paint("Setup complete.", C.B))
    cmd_app(args)   # keep ~/Applications/Layover.app in sync
    info("Next:  layover steam        (first launch downloads Steam's update, then shows the login window)")
    info("Then:  install games in Steam as usual, and `layover games` / `layover play <name>`")
    info("Before a flight:  layover flight")
    print()
    if not args.no_launch and tty():
        try:
            ans = input("  Launch Steam now? [Y/n] ").strip().lower()
        except EOFError:
            ans = "n"
        if ans in ("", "y", "yes"):
            cmd_steam(argparse.Namespace(offline=False, online=False, game=None, extra=[]))


def require_setup():
    if not engine_ready() or not steam_installed():
        die("not set up yet → run: layover setup", 5)


STATE_PATH = os.path.join(ROOT, "running.json")


def running_state():
    try:
        with open(STATE_PATH) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def running_renderer():
    return running_state().get("renderer")


def remove_legacy_engines():
    """Delete engine folders from earlier experiments (2+ GB). Only while nothing runs in the prefix."""
    if steam_running() or prefix_running():
        return
    for old in LEGACY_ENGINES + [RENDERERS]:
        if os.path.isdir(old):
            shutil.rmtree(old, ignore_errors=True)
            info(f"removed old engine files {os.path.basename(old)}")


def launch_steam(cfg, game=None, offline=None, extra_args=None):
    """Start Windows Steam in our prefix (detached). Returns log path."""
    remove_legacy_engines()
    if offline is not None:
        set_offline_mode("windows", offline)
    renderer = resolve_renderer(cfg, game)
    if not renderer_installed(renderer):
        die(f"renderer '{renderer}' is not installed → layover setup")
    args = [STEAM_EXE] + list(cfg.get("steam_args") or []) + list(extra_args or [])
    if cfg.get("webhelper_wrapper", False):
        install_webhelper_wrapper()
        # keep Steam's self-check from putting its own helper back over the wrapper
        args += ["-noverifyfiles", "-nobootstrapupdate", "-skipinitialbootstrap", "-norepairfiles"]
    else:
        remove_webhelper_wrapper()
    install_ags_shim()
    install_d3d12_shim()
    apply_retina(cfg, game)
    fp = launch_fingerprint(cfg, game)
    if fp["retina"] and not any(a.startswith("-forcedesktopscaling") for a in args):
        args += ["-forcedesktopscaling", "2"]   # keep Steam's UI readable on the 2x desktop
    write_shim_env(cfg, game)
    log = new_log("steam")
    if game:
        args += ["-applaunch", str(game)]
    wine(cfg, args, game=game, wait=False, log=log, cwd=STEAM_DIR, extra_env={"LAYOVER_RENDERER": renderer})
    with open(STATE_PATH, "w") as f:
        json.dump(dict(fp, started=_dt.datetime.now().isoformat(), game=game), f)
    return log


