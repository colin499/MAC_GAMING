def owned_games(include_free=True, cfg=None):
    """Every game this account can install, from Steam's local caches: purchases (packageinfo), Steam's
    complimentary titles (package 0; owned=False, returned only with include_free), played apps (localconfig),
    installed apps (appmanifests). Each entry carries appid, name, type, owned, source[], dlc_owned[] and the
    appinfo summary fields (oslist, launch, deck_category, developer, ...)."""
    apps, _ = cached_appinfo()
    apps = apps or {}
    pkgs, _ = cached_packageinfo()
    pkgs = pkgs or {}
    played = localconfig_apps()
    installed = {g["appid"]: g for g in all_games() if g["where"] == "windows"}
    web = web_owned_games(cfg or load_config()) or {}
    licensed, free = set(), set()
    for pid, pk in pkgs.items():
        (free if str(pid) == "0" else licensed).update(str(a) for a in (pk or {}).get("appids", []))
    try:
        assets = {d for d in os.listdir(LIBRARYCACHE) if d.isdigit()}
    except OSError:
        assets = set()
    ids = licensed | set(installed) | set(web) | {a for a, p in played.items() if p["last_played"] or p["playtime_min"]}
    if include_free:
        ids |= free
    out = {}
    dlc_parents = {}
    for appid in ids:
        s = apps.get(appid) or {}
        typ = s.get("type") or ("game" if appid in installed else ("game" if appid in web else "unknown"))
        if typ == "dlc":
            parent = s.get("parent")
            if parent and appid in licensed:
                dlc_parents.setdefault(parent, []).append(appid)
            continue
        if typ in NON_GAME_TYPES:
            continue
        source = []
        if appid in licensed:
            source.append("license")
        if appid in free:
            source.append("free")
        if appid in web:
            source.append("web")
        if appid in played and (played[appid]["last_played"] or played[appid]["playtime_min"]):
            source.append("played")
        if appid in installed:
            source.append("installed")
        if appid in assets:
            source.append("assets")
        if typ in ("demo", "unknown") and not ({"installed", "played", "license", "web"} & set(source)):
            continue   # Steam's complimentary demos and ids it never described: not worth a tile
        owned = bool({"license", "installed", "played", "web"} & set(source))
        name = s.get("name") or installed.get(appid, {}).get("name") or web.get(appid, {}).get("name") or f"App {appid}"
        g = dict(s)
        g.update({"appid": appid, "name": name, "type": typ, "owned": owned, "source": source, "dlc_owned": [],
                  "last_played": max(played.get(appid, {}).get("last_played", 0), web.get(appid, {}).get("last_played", 0) or 0),
                  "playtime_min": max(played.get(appid, {}).get("playtime_min", 0), web.get(appid, {}).get("playtime_min", 0) or 0),
                  "launch_options": played.get(appid, {}).get("launch_options", "")})
        g.setdefault("launch", [])
        out[appid] = g
    for parent, dlcs in dlc_parents.items():
        if parent in out:
            out[parent]["dlc_owned"] = sorted(dlcs)
    return sorted(out.values(), key=lambda g: g["name"].lower())


def find_owned(query, include_free=True):
    """An owned (or free) game by appid, exact name, or unique name fragment; None otherwise."""
    q = str(query).strip().lower()
    games = owned_games(include_free=include_free)
    for g in games:
        if g["appid"] == q or g["name"].lower() == q:
            return g
    subs = [g for g in games if q in g["name"].lower()]
    return subs[0] if len(subs) == 1 else None


def find_any_game(query):
    """Installed game (find_game) or, failing that, an owned-but-not-installed one shaped like an installed entry."""
    g = find_game(query, all_games())
    if g:
        g.setdefault("installed", True)
        return g
    o = find_owned(query)
    if o:
        return {"appid": o["appid"], "name": o["name"], "where": "windows", "ready": False, "installed": False,
                "owned": o["owned"], "size": 0, "flags": 0, "needs_update": False, "library": None, "installdir": o.get("installdir", "")}
    return None


def renderer_for(cfg, appid, dx12=None):
    """resolve_renderer() without the executable scan, for listings. Returns (renderer, why)."""
    g = cfg["games"].get(str(appid), {})
    if g.get("renderer"):
        return g["renderer"], "game"
    if (cfg.get("renderer") or "auto") != "auto":
        return cfg["renderer"], "default"
    if dx12 is None:
        return "dxmt", "unknown"
    return ("d3dmetal" if dx12 else "dxmt"), "auto"


def running_game_installdirs():
    """steamapps/common/<installdir> folder names of games running in our prefix (lowercase)."""
    dirs = set()
    for line in sh(["ps", "-axo", "command"]).splitlines():
        if is_game_process(line):
            m = re.search(r"steamapps[/\\]common[/\\]([^/\\]+)[/\\]", line, re.I)
            if m:
                dirs.add(m.group(1).lower())
    return dirs


# --------------------------------------------------------------------------- cover art
def cover_paths(appid, assets=None):
    """Local image per kind (capsule 600x900, header, hero, logo, icon, hero_blur) or None: our covers/ folder
    (CDN downloads, full size), then Steam's librarycache (asset cache slots, then well-known names in the
    appid folder and its sha subfolders). The 32x32 icon is never used as a capsule."""
    assets = assets if assets is not None else parse_assetcache()
    appid = str(appid)
    out = {k: None for k in COVER_KINDS}
    own = os.path.join(COVERS, appid)
    for kind in COVER_KINDS:
        for ext in ("jpg", "png"):
            p = os.path.join(own, f"{kind}.{ext}")
            if os.path.isfile(p):
                out[kind] = p
                break
    base = os.path.join(LIBRARYCACHE, appid)
    for kind, rel in (assets.get(appid) or {}).items():
        if kind in out and not out[kind]:
            p = os.path.join(base, rel.replace("\\", "/"))
            if os.path.isfile(p):
                out[kind] = p
    if os.path.isdir(base) and not all(out[k] for k in ("capsule", "header", "hero")):
        try:
            dirs = [base] + [os.path.join(base, d) for d in sorted(os.listdir(base)) if os.path.isdir(os.path.join(base, d))]
        except OSError:
            dirs = [base]
        for kind, names in COVER_FILES.items():
            if out[kind]:
                continue
            for d in dirs:
                hit = next((os.path.join(d, n) for n in names if os.path.isfile(os.path.join(d, n))), None)
                if hit:
                    out[kind] = hit
                    break
    return out


def cover_urls(appid):
    return {k: COVER_CDN[0].format(appid=appid, file=f) for k, f in COVER_CDN_FILE.items()}


def _rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def fetch_url(url, dest, timeout=6):
    """Download url to dest atomically. True on success, False on an HTTP error (404: there is no such
    file), None on a network error (offline: try again later)."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=timeout) as r, open(dest + ".part", "wb") as f:
            shutil.copyfileobj(r, f)
        os.replace(dest + ".part", dest)
        return True
    except urllib.error.HTTPError:
        _rm(dest + ".part")
        return False
    except (OSError, ValueError):
        _rm(dest + ".part")
        return None


def fetch_covers(appids, kinds=("capsule", "header", "hero"), budget_s=25.0, assets=None):
    """Fill covers/<appid>/<kind>.jpg from Steam's CDN for whatever the local caches lack. A 404 is remembered
    in covers/<appid>/missing.json for 7 days. Returns {appid: {kind: have|ok|missing|error|skipped}}."""
    assets = assets if assets is not None else parse_assetcache()
    t0 = time.time()
    report = {}
    for appid in appids:
        appid = str(appid)
        have = cover_paths(appid, assets)
        own = os.path.join(COVERS, appid)
        mpath = os.path.join(own, "missing.json")
        try:
            with open(mpath) as f:
                missing = json.load(f)
        except (OSError, ValueError):
            missing = {}
        rep = report.setdefault(appid, {})
        for kind in kinds:
            if have.get(kind):
                rep[kind] = "have"
                continue
            if time.time() - missing.get(kind, 0) < 7 * 86400:
                rep[kind] = "missing"
                continue
            if time.time() - t0 > budget_s:
                rep[kind] = "skipped"
                continue
            fname = COVER_CDN_FILE.get(kind)
            if not fname:
                rep[kind] = "missing"
                continue
            dest = os.path.join(own, kind + os.path.splitext(fname)[1])
            os.makedirs(own, exist_ok=True)
            res = None
            for tmpl in COVER_CDN:
                res = fetch_url(tmpl.format(appid=appid, file=fname), dest)
                if res:
                    break
            if res:
                rep[kind] = "ok"
            elif res is False:
                missing[kind] = time.time()
                rep[kind] = "missing"
            else:
                rep[kind] = "error"
        if missing:
            try:
                with open(mpath, "w") as f:
                    json.dump(missing, f)
            except OSError:
                pass
    return report


def spawn_detached(argv):
    """Run `layover <argv...>` as a detached background process (output to logs/background.log)."""
    try:
        os.makedirs(LOGS, exist_ok=True)
        log = open(os.path.join(LOGS, "background.log"), "ab")
        subprocess.Popen([sys.executable, os.path.abspath(__file__)] + list(argv), stdout=log, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


