def cmd_play(args):
    cfg = load_config()
    games = all_games()
    g = find_game(args.game, games)
    if not g:
        o = find_owned(args.game)
        if o and getattr(args, "install", False):
            cmd_install(argparse.Namespace(appid=o["appid"], json=JSON_MODE))
            return
        if o:
            die(f"{o['name']} is not installed (layover install {o['appid']})", 3)
        die(f"no game matches '{args.game}' (layover library)", 3)
    if g["where"] == "mac":
        ok(f"launching {g['name']} in native Mac Steam")
        subprocess.run(["open", f"steam://rungameid/{g['appid']}"])
        emit({"ok": True, "appid": g["appid"], "where": "mac"})
        return
    require_setup()
    apply_profile_if_pending(cfg, g["appid"])
    renderer = resolve_renderer(cfg, g["appid"])
    restart = None
    fp = launch_fingerprint(cfg, g["appid"])
    state = running_state()
    if steam_running() and running_renderer() not in (None, renderer):
        restart = f"{g['name']} uses the {renderer} renderer; Steam is running with {running_renderer()}"
    elif steam_running() and state.get("retina") not in (None, fp["retina"]):
        restart = f"{g['name']} needs retina {'on' if fp['retina'] else 'off'}; Steam was started with it {'on' if state.get('retina') else 'off'}"
    elif steam_running() and state and state.get("env", {}) != fp["env"]:
        restart = f"{g['name']}'s renderer settings differ from the ones Steam was started with"
    if restart:
        info(restart + ". Restarting Steam.")
        wineserver_kill(cfg)
        for _ in range(30):
            if not steam_running():
                break
            time.sleep(1)
    if steam_running():
        install_d3d12_shim()
        apply_retina(cfg, g["appid"])
        write_shim_env(cfg, g["appid"])
        wait_for_steam_logon()
        if steam_launch_prompt(g["appid"]):
            warn("Steam is still showing a dialog from the last launch of this game; answer it in Steam's window")
            wine(cfg, ["start", "steam://open/main"], wait=False)
            time.sleep(2)
        wine(cfg, ["start", f"steam://rungameid/{g['appid']}"], game=g["appid"], wait=False)
        spawn_watch(g["appid"], g["name"])
        ok(f"asked Steam to launch {g['name']} ({renderer})")
        if JSON_MODE:   # the app watches steam.launch_prompt_appid in `library --json` instead of waiting here
            emit({"ok": True, "appid": g["appid"], "renderer": renderer, "restarted_steam": bool(restart), "started_steam": False})
            return
        time.sleep(8)
        if steam_launch_prompt(g["appid"]):
            warn("Steam wants an answer before it starts the game: look at its window (a sync or notice dialog)")
            notify("Layover", "Steam is asking something before it starts the game: look at its window")
    else:
        offline = True if args.offline else None
        log = launch_steam(cfg, game=g["appid"], offline=offline)
        spawn_watch(g["appid"], g["name"])
        ok(f"starting Steam → {g['name']} ({renderer}); log: {log}")
        emit({"ok": True, "appid": g["appid"], "renderer": renderer, "restarted_steam": bool(restart), "started_steam": True})


